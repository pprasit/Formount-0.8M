<Window x:Class="ForkMount_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForkMount_WPF"
        xmlns:ui="clr-namespace:ForkMount_WPF.UI"
        mc:Ignorable="d"
        Title="ForkMount-WPF - Platinum Drive Control System" 
        Height="900" Width="1600"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <SolidColorBrush x:Key="DarkBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CardBackground" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
        
        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Border Background="{StaticResource DarkBackground}"
            CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" 
                            Opacity="0.8" 
                            ShadowDepth="0" 
                            BlurRadius="30"
                            Direction="0"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" 
                    Background="#2D2D30"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="55">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Side Buttons -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="15,0,0,0">
                        
                        <!-- ENABLE/DISABLE Button -->
                        <Button x:Name="btnToggleDrives"
                                Click="BtnToggleDrives_Click"
                                Height="36"
                                Width="110"
                                Margin="0,0,8,0"
                                ToolTip="Enable/Disable all 4 axes"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#10B981"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#10B981" 
                                                                        Opacity="0.4" 
                                                                        ShadowDepth="0" 
                                                                        BlurRadius="12"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#059669"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#047857"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock x:Name="txtToggleDrives" Text="ENABLE" 
                                     FontWeight="SemiBold" FontSize="13"/>
                        </Button>

                        <!-- STOP Button -->
                        <Button x:Name="btnEmergencyStop"
                                Click="BtnEmergencyStop_Click"
                                Height="36"
                                Width="90"
                                ToolTip="Emergency Stop - Stop all motion"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#EF4444"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#EF4444" 
                                                                        Opacity="0.5" 
                                                                        ShadowDepth="0" 
                                                                        BlurRadius="15"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="STOP"
                                                             Foreground="{TemplateBinding Foreground}"
                                                             FontWeight="{TemplateBinding FontWeight}"
                                                             FontSize="{TemplateBinding FontSize}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Tracking and Control Button -->
                        <Button x:Name="btnTrackingAndControl"
                                Click="BtnManualControl_Click"
                                Height="36"
                                Width="150"
                                Margin="8,0,0,0"
                                ToolTip="Open Tracking and Control Window"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center">
                                                        <TextBlock Text="Tracking and Control"
                                                                 Foreground="{TemplateBinding Foreground}"
                                                                 FontWeight="{TemplateBinding FontWeight}"
                                                                 FontSize="{TemplateBinding FontSize}"
                                                                 VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#60A5FA"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Image Verification and Offset Button -->
                        <Button x:Name="btnImageVerificationAndOffset"
                                Click="BtnImageVerificationAndOffset_Click"
                                Height="36"
                                Width="190"
                                Margin="8,0,0,0"
                                ToolTip="Open Image Verification and Offset Window"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#8B5CF6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center">
                                                        <TextBlock Text="Image Verification"
                                                                 Foreground="{TemplateBinding Foreground}"
                                                                 FontWeight="{TemplateBinding FontWeight}"
                                                                 FontSize="{TemplateBinding FontSize}"
                                                                 VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#A78BFA"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#7C3AED"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Title + Pointing Model Status -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="ForkMount-WPF - Platinum Drive Control System" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0"/>
                        
                        <!-- Pointing Model Status Badge -->
                        <Border x:Name="PointingModelBadge"
                                Background="#374151"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PointingModelIndicator"
                                        Width="8" Height="8"
                                        Fill="#6B7280"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"/>
                                <TextBlock x:Name="PointingModelState" 
                                          Text="No Model" 
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Foreground="#9CA3AF"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        
                        <!-- Settings Button (Gear Icon) -->
                        <Button x:Name="btnSettings"
                                Style="{StaticResource WindowControlButton}"
                                Click="SettingsButton_Click"
                                ToolTip="System Settings"
                                Width="46">
                            <Path Data="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"/>
                        </Button>
                        
                        <!-- Minimize Button -->
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <TextBlock Text="─" 
                                       FontSize="14"
                                       Margin="0,0,0,0"/>
                        </Button>
                        
                        <!-- Maximize/Restore Button -->
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowControlButton}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize">
                            <TextBlock x:Name="MaximizeIcon" 
                                       Text="☐" 
                                       FontSize="14"/>
                        </Button>
                        
                        <!-- Close Button -->
                        <Button Style="{StaticResource CloseButton}"
                                Click="CloseButton_Click"
                                ToolTip="Close">
                            <TextBlock Text="✕" 
                                       FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>
                
                <!-- Azimuth Section -->
                <GroupBox Grid.Row="0" 
                          Header="Azimuth Control"
                          Margin="0,0,0,8"
                          Foreground="White"
                          BorderThickness="0">
                    <GroupBox.Style>
                        <Style TargetType="GroupBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupBox">
                                        <Border Background="#1A1F2E"
                                                BorderThickness="0,0,3,0"
                                                CornerRadius="12"
                                                Padding="0">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FF6B35" Offset="0.0"/>
                                                    <GradientStop Color="#F59E0B" Offset="0.5"/>
                                                    <GradientStop Color="#FCD34D" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                            
                                                <!-- Vertical Header -->
                                                <Border Grid.Column="0" 
                                                        Background="#252D3D"
                                                        CornerRadius="12,0,0,12"
                                                        Padding="12,16">
                                                    <TextBlock FontWeight="SemiBold"
                                                             FontSize="16"
                                                             Foreground="White"
                                                             VerticalAlignment="Center">
                                                        <TextBlock.LayoutTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </TextBlock.LayoutTransform>
                                                        <ContentPresenter ContentSource="Header"/>
                                                    </TextBlock>
                                                </Border>
                                                
                                                <!-- Content -->
                                                <ContentPresenter Grid.Column="1" Margin="16"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupBox.Style>
                    <ui:Azimuth_Controller HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </GroupBox>
                
                <!-- Altitude Section -->
                <GroupBox Grid.Row="1" 
                          Header="Altitude Control"
                          Margin="0,8,0,8"
                          Foreground="White"
                          BorderThickness="0">
                    <GroupBox.Style>
                        <Style TargetType="GroupBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupBox">
                                        <Border Background="#1A1F2E"
                                                BorderThickness="0,0,3,0"
                                                CornerRadius="12"
                                                Padding="0">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#0284C7" Offset="0.0"/>
                                                    <GradientStop Color="#38BDF8" Offset="0.5"/>
                                                    <GradientStop Color="#BAE6FD" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Vertical Header -->
                                                <Border Grid.Column="0" 
                                                        Background="#252D3D"
                                                        CornerRadius="12,0,0,12"
                                                        Padding="12,16">
                                                    <TextBlock FontWeight="SemiBold"
                                                             FontSize="16"
                                                             Foreground="White"
                                                             VerticalAlignment="Center">
                                                        <TextBlock.LayoutTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </TextBlock.LayoutTransform>
                                                        <ContentPresenter ContentSource="Header"/>
                                                    </TextBlock>
                                                </Border>
                                                
                                                <!-- Content -->
                                                <ContentPresenter Grid.Column="1" Margin="16"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupBox.Style>
                    <ui:Altitude_Controller HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </GroupBox>
                
                <!-- Log Section -->
                <GroupBox Grid.Row="2" 
                          Header="System Logs"
                          Margin="0,8,0,0"
                          Foreground="White"
                          BorderThickness="0">
                    <GroupBox.Style>
                        <Style TargetType="GroupBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupBox">
                                        <Border Background="#0A0A0D"
                                                BorderThickness="0,0,3,0"
                                                CornerRadius="12"
                                                Padding="0">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                    <GradientStop Color="#3B82F6" Offset="0.5"/>
                                                    <GradientStop Color="#10B981" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Vertical Header -->
                                                <Border Grid.Column="0" 
                                                        Background="#2D2D30"
                                                        CornerRadius="12,0,0,12"
                                                        Padding="12,16">
                                                    <TextBlock FontWeight="SemiBold"
                                                             FontSize="16"
                                                             Foreground="White"
                                                             VerticalAlignment="Center">
                                                        <TextBlock.LayoutTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </TextBlock.LayoutTransform>
                                                        <ContentPresenter ContentSource="Header"/>
                                                    </TextBlock>
                                                </Border>
                                                
                                                <!-- Content -->
                                                <ContentPresenter Grid.Column="1" Margin="16"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupBox.Style>
                    <ui:SimpleLogPanel x:Name="SystemLogPanel" 
                                       HorizontalAlignment="Stretch" 
                                       VerticalAlignment="Stretch"/>
                </GroupBox>
            </Grid>
        </Grid>
    </Border>
</Window>
