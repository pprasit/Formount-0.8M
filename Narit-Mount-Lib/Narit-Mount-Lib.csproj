<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ForkMount_WPF</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8618,CS8600,CS8601,CS8602,CS8603,CS8604,CS8622,CS8625,NU1701</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- ⭐ NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.57" />
    <PackageReference Include="System.IO.Ports" Version="10.0.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="MongoDB.Driver" Version="3.6.0" />
    
    <!-- AForge.NET for image processing and star detection -->
    <PackageReference Include="AForge" Version="2.2.5" />
    <PackageReference Include="AForge.Imaging" Version="2.2.5" />
    <PackageReference Include="AForge.Math" Version="2.2.5" />
    
    <!-- ZWO Camera SDK - Copy native DLLs to output -->
    <PackageReference Include="ZWOptical.SDK" Version="3.4.531">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ⭐ Ensure ZWO native DLLs are copied to output -->
  <Target Name="CopyZWONativeDlls" AfterTargets="Build">
    <ItemGroup>
      <ZWODlls Include="$(NuGetPackageRoot)zwoptical.sdk\3.4.531\runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ZWODlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Text="Copied ZWO SDK DLLs to output directory" Importance="high" />
  </Target>

  <!-- ⭐ Ensure FLI native DLL is copied to output root (P/Invoke requires it at root) -->
  <Target Name="CopyFLINativeDll" AfterTargets="Build">
    <Copy SourceFiles="dll\libfli64.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Text="Copied FLI SDK DLL to output directory" Importance="high" />
  </Target>

  <!-- ⭐ Elmo Motion Control DLL References for Platinum Drive -->
  <ItemGroup>
    <Reference Include="ElmoMotionControlComponents.Drive.EASComponents">
      <HintPath>dll\ElmoMotionControlComponents.Drive.EASComponents.dll</HintPath>
      <Private>True</Private>
    </Reference>
    
    <Reference Include="ElmoMotionControlComponents.GMAS.MMCLibDotNET">
      <HintPath>dll\ElmoMotionControlComponents.GMAS.MMCLibDotNET.dll</HintPath>
      <Private>True</Private>
    </Reference>
    
    <Reference Include="PWLib">
      <HintPath>dll\PWLib.dll</HintPath>
    </Reference>
    
    <Reference Include="PXPLib">
      <HintPath>dll\PXPLib.dll</HintPath>
    </Reference>
    
    <Reference Include="SRSLib">
      <HintPath>dll\SRSLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- ⭐ Copy DLL files to output directory when building -->
  <ItemGroup>
    <None Include="dll\**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="AppSetting.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Data\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Manual\" />
  </ItemGroup>

</Project>
