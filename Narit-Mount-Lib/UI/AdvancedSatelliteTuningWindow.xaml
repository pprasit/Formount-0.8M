<Window x:Class="ForkMount_WPF.UI.AdvancedSatelliteTuningWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Advanced Satellite Tracking Tuning"
Height="800"
Width="750"
WindowStartupLocation="CenterOwner"
Background="#0F1419"
WindowStyle="None"
AllowsTransparency="True"
ResizeMode="CanResize"
MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <SolidColorBrush x:Key="DarkBackground" Color="#0F1419"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1A1F2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D3748"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                    Content="{TemplateBinding SelectionBoxItem}"
                                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                    Margin="{TemplateBinding Padding}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource TextSecondary}"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border Background="#1F2937"
                                        BorderBrush="#4B5563"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#374151"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    
    <Border BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Background="#0F1419">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" 
                    Background="#1F2937" 
                    CornerRadius="8,8,0,0"
                    BorderBrush="#2D3748"
                    BorderThickness="0,0,0,1">
                <Grid Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="Advanced Satellite Tracking Tuning"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    
                    <Button Grid.Column="1"
                            Content="✕"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0"
                            FontSize="16"
                            Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EF4444"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Advanced Satellite Tracking Tuning"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Separate PD gains for each axis - fine-tune Azimuth and Altitude independently"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"/>
        </StackPanel>
        
        <!-- Parameters ScrollViewer -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- AZIMUTH AXIS PD Gains -->
                <Border Background="#1F2937"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,12">
                    <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="Azimuth Axis PD Gains"
                                       Foreground="#3B82F6"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Proportional (Kp)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtAzKp"
                                         Text="0.30"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="↑ Faster response"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Integral (Ki)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtAzKi"
                                         Text="0.00"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="↑ Remove SS error"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Derivative (Kd)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtAzKd"
                                         Text="0.080"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="↑ More damping"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Velocity FF (VFF)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtAzVffGain"
                                         Text="0.90"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="0.8-1.0 recommended"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Azimuth Prediction Time -->
                        <Border Background="#374151"
                                BorderBrush="#4B5563"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Adaptive Prediction Time"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Base (Low Alt)"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtAzBasePrediction"
                                                     Text="50"
                                                     Width="60"
                                                     Height="32"
                                                     Style="{StaticResource ModernTextBox}"
                                                     TextAlignment="Center"
                                                     FontSize="13"/>
                                            <TextBlock Text="ms"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Max (High Alt)"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtAzMaxPrediction"
                                                     Text="500"
                                                     Width="60"
                                                     Height="32"
                                                     Style="{StaticResource ModernTextBox}"
                                                     TextAlignment="Center"
                                                     FontSize="13"/>
                                            <TextBlock Text="ms"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- ALTITUDE AXIS PD Gains -->
                <Border Background="#1F2937"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,12">
                    <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="Altitude Axis PD Gains"
                                       Foreground="#10B981"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Proportional (Kp)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtAltKp"
                                         Text="0.30"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="↑ Faster response"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Integral (Ki)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtAltKi"
                                         Text="0.00"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="↑ Remove SS error"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Derivative (Kd)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtAltKd"
                                         Text="0.080"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="↑ More damping"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Velocity FF (VFF)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtAltVffGain"
                                         Text="0.90"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="0.8-1.0 recommended"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Altitude Prediction Time -->
                        <Border Background="#374151"
                                BorderBrush="#4B5563"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Adaptive Prediction Time"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Base (Low Alt)"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtAltBasePrediction"
                                                     Text="50"
                                                     Width="60"
                                                     Height="32"
                                                     Style="{StaticResource ModernTextBox}"
                                                     TextAlignment="Center"
                                                     FontSize="13"/>
                                            <TextBlock Text="ms"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Max (High Alt)"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtAltMaxPrediction"
                                                     Text="500"
                                                     Width="60"
                                                     Height="32"
                                                     Style="{StaticResource ModernTextBox}"
                                                     TextAlignment="Center"
                                                     FontSize="13"/>
                                            <TextBlock Text="ms"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- VELOCITY OUTPUT FILTER (shared) -->
                <Border Background="#1F2937"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Velocity Output Filter"
                                       Foreground="#F59E0B"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Filter Alpha (α)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtVelFilterAlpha"
                                         Text="0.30"
                                         Width="100"
                                         Height="36"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         FontSize="15"
                                         FontWeight="SemiBold"/>
                                <TextBlock Text="0.20 - 0.80 recommended"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                <TextBlock Text="Max Integral Clamp"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="txtMaxIntegral"
                                             Text="5.0"
                                             Width="80"
                                             Height="36"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"
                                             FontSize="15"
                                             FontWeight="SemiBold"/>
                                    <TextBlock Text="deg"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Anti-windup limit"
                                           Foreground="#6B7280"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Info Panel -->
                <Border Background="#1F2937"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="ℹ️ Tuning Guidelines"
                                   Foreground="#F59E0B"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        
                        <TextBlock Foreground="{StaticResource TextSecondary}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   LineHeight="16">
                            <Run Text="• Higher Kp = Faster tracking response (may cause oscillation)"/>
                            <LineBreak/>
                            <Run Text="• Higher Kd = More damping, smoother motion"/>
                            <LineBreak/>
                            <Run Text="• VFF 0.9-1.0 = Feedforward velocity for prediction"/>
                            <LineBreak/>
                            <Run Text="• Prediction time adjusts based on satellite altitude"/>
                            <LineBreak/>
                            <Run Text="• Each axis can have different tuning for optimal tracking"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Action Buttons -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel"
                        Content="Cancel"
                        Width="100"
                        Height="40"
                        Background="#374151"
                        Foreground="{StaticResource TextPrimary}"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,12,0"
                        Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4B5563"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button x:Name="btnApply"
                        Content="Apply"
                        Width="100"
                        Height="40"
                        Background="{StaticResource PrimaryAccent}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnApply_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2563EB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
        </Grid>
    </Border>
</Window>
