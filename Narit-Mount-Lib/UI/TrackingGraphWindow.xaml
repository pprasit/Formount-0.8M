<Window x:Class="ForkMount_WPF.UI.TrackingGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Tracking Accuracy Graph"
        Height="560"
        Width="940"
        MinHeight="420"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2D2D30"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Measurements"
                               Foreground="#9CA3AF"
                               FontSize="11"/>
                    <TextBlock x:Name="txtMeasurementsValue"
                               Text="--"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="RA Drift"
                               Foreground="#9CA3AF"
                               FontSize="11"/>
                    <TextBlock x:Name="txtRaDriftValue"
                               Text="--"
                               Foreground="#60A5FA"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="RMS Error"
                               Foreground="#9CA3AF"
                               FontSize="11"/>
                    <TextBlock x:Name="txtRmsValue"
                               Text="--"
                               Foreground="#10B981"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Peak Error"
                               Foreground="#9CA3AF"
                               FontSize="11"/>
                    <TextBlock x:Name="txtPeakValue"
                               Text="--"
                               Foreground="#F59E0B"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   x:Name="txtGraphStatus"
                   Text="Run a seeing + tracking series to display drift and total tracking error."
                   Foreground="#9CA3AF"
                   FontSize="12"
                   Margin="4,0,0,10"/>

        <Border Grid.Row="2"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
            <ScottPlot:WpfPlot x:Name="wpfTrackingPlot"/>
        </Border>
    </Grid>
</Window>
