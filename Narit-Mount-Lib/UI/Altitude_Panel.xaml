<UserControl x:Class="ForkMount_WPF.UI.Altitude_Panel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ForkMount_WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1920"
             Background="Transparent">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Altitude Controller Panel -->
        <Grid x:Name="AltitudeStatusPanel" Grid.Column="0" Margin="0,0,10,0">
            <local:Altitude_Controller HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
        
        <!-- Right Panel - Chart Placeholder -->
        <Border Grid.Column="1" 
                Margin="10,0,0,0"
                Background="#2A3040"
                CornerRadius="12"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.3" ShadowDepth="2" BlurRadius="10"/>
            </Border.Effect>
            
            <TextBlock Text="Chart - Coming Soon"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       Foreground="White"/>
        </Border>
    </Grid>
</UserControl>
