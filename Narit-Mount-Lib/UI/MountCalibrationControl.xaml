<UserControl x:Class="ForkMount_WPF.UI.MountCalibrationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ForkMount_WPF.UI"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1400">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
        
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False"/>

                                    <ToggleButton Grid.Column="1"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#D1D5DB"
                                              Width="8"
                                              Height="4"
                                              Stretch="Fill"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#1F2937"
                                        BorderBrush="#4B5563"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background" Value="#1F2937"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#374151"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#374151"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowBackground" Value="#1F2937"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20,0,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="700"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions> 

        <!-- Left Side: Controls and DataGrid -->
                <!-- Control Buttons Section -->
            <Grid Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Button 1: New Pointing Model -->
                <Button Grid.Row="0" Grid.Column="0"                                
                                x:Name="btnNewPointingModel"
                                Content="New Pointing Model"
                                Click="BtnNewPointingModel_Click"
                                Style="{StaticResource ModernButton}"
                                HorizontalAlignment="Stretch"
                                Height="40"/>

                <!-- Button 2: Load Pointing Model File -->
                <Button Grid.Row="0" Grid.Column="2"
                                x:Name="btnLoadPointingModel"
                                Content="Load Pointing Model File"
                                Click="BtnLoadPointingModel_Click"
                                Height="40"
                                Background="#FF3B82F6"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="0,0,0,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#6366F1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4F46E5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Button 3: Camera Settings -->
                <Button Grid.Row="0" Grid.Column="4"
                       x:Name="btnCameraSettings"
                       Click="BtnCameraSettings_Click"
                       Height="40"
                       Width="140"
                       Background="#FF3B82F6"
                       Foreground="White"
                       BorderThickness="0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Cursor="Hand">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="ellipseCameraStatus"
                                 Width="10"
                                 Height="10"
                                 Fill="#6B7280"
                                 Stroke="#9CA3AF"
                                 StrokeThickness="1"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtCameraControlLabel"
                                   Text="Camera Control"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#8B5CF6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7C3AED"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <TextBlock Text="Model Engine:"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="cmbPointingModelBackend"
                              Width="220"
                              Height="32"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="CmbPointingModelBackend_SelectionChanged">
                        <ComboBoxItem Content="Legacy (.pxp reload)"
                                      Tag="LegacyPxpReload"/>
                        <ComboBoxItem Content="Experimental (Core Direct)"
                                      Tag="ExperimentalCoreDirect"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <!-- Grid Configuration Section -->
                <Border Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,15"
                        Grid.Row="1">
                    <Grid Margin="20,15,20,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>   <!-- 0: Label Az -->
                            <ColumnDefinition Width="80"/>     <!-- 1: TextBox Az -->
                            <ColumnDefinition Width="20"/>     <!-- 2: Spacer -->
                            <ColumnDefinition Width="Auto"/>   <!-- 3: Label Alt -->
                            <ColumnDefinition Width="80"/>     <!-- 4: TextBox Alt -->
                            <ColumnDefinition Width="20"/>     <!-- 5: Spacer -->
                            <ColumnDefinition Width="*"/>      <!-- 6: Buttons -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Row 0: Points -->
                            <RowDefinition Height="Auto"/>  <!-- Row 1: Min/Max Alt -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Azimuth Points -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Azimuth Points:"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 x:Name="txtAzimuthPoints"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="8"
                                 Height="30"
                                 FontSize="14"
                                 TextChanged="PointsTextBox_TextChanged" 
                                 VerticalAlignment="Center" 
                                 Padding="10,0,0,0"/>

                        <!-- Row 0: Altitude Points -->
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="Altitude Points:"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="4"
                                 x:Name="txtAltitudePoints"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="5"
                                 Height="30"
                                 FontSize="14"
                                 TextChanged="PointsTextBox_TextChanged" 
                                 VerticalAlignment="Center"
                                 Padding="10,0,0,0"/>

                        <!-- Row 0: Buttons -->
                        <StackPanel Grid.Row="0" Grid.Column="6"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                            <!-- Button: Create Points -->
                            <Button x:Name="btnCreatePoint"
                                    Content="Create Points"
                                    Click="BtnCreatePoint_Click"
                                    Width="120"
                                    Height="30"
                                    Background="#10B981"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#10B981"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#059669"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <!-- Button: Add Point (Manual Calibration) -->
                            <Button x:Name="btnAddPoint"
                                    Content="Add Point"
                                    Click="BtnAddPoint_Click"
                                    Width="110"
                                    Height="30"
                                    Background="#10B981"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    ToolTip="Add calibration point at current mount position">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#8B5CF6"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#7C3AED"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#4B5563"/>
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Row 1: Min Altitude -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Min Altitude:"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,8,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 x:Name="txtMinAltitude"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="30"
                                 Height="30"
                                 FontSize="14"
                                 LostFocus="TxtAltitudeRange_LostFocus"
                                 VerticalAlignment="Center"
                                 Padding="10,0,0,0"
                                 Margin="0,8,0,0"
                                 ToolTip="Minimum altitude (degrees) for pointing model grid"/>

                        <!-- Row 1: Max Altitude -->
                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="Max Altitude:"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,8,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="4"
                                 x:Name="txtMaxAltitude"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="85"
                                 Height="30"
                                 FontSize="14"
                                 LostFocus="TxtAltitudeRange_LostFocus"
                                 VerticalAlignment="Center"
                                 Padding="10,0,0,0"
                                 Margin="0,8,0,0"
                                 ToolTip="Maximum altitude (degrees) for pointing model grid"/>

                        <TextBlock Grid.Row="1" Grid.Column="6"
                                   Text="°"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- DataGrid 7: Pointing Model Data -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="0"
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch" Margin="0,0,0,15">
                <DataGrid x:Name="dgPointingModel"
                              Style="{StaticResource DataGridStyle}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              SelectionChanged="DgPointingModel_SelectionChanged">
                    <DataGrid.Columns>
                        <!-- Column: Delete Button (per row) -->
                        <DataGridTemplateColumn Header="🗑" Width="40">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#374151"/>
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="5,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush" Value="#4B5563"/>
                                    <Setter Property="ToolTip" Value="Delete point"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="BtnDeleteSinglePoint_Click"
                                            Tag="{Binding Index}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Delete this point"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="4">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Path Data="M9 3V4H4V6H5V19C5 20.1 5.9 21 7 21H17C18.1 21 19 20.1 19 19V6H20V4H15V3H9M7 6H17V19H7V6M9 8V17H11V8H9M13 8V17H15V8H13Z"
                                                          Fill="#6B7280"
                                                          Stretch="Uniform"
                                                          Width="14" Height="14"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#374151"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Column: Include in Model (CheckBox) -->
                        <DataGridCheckBoxColumn Header="✓"
                                                Binding="{Binding IsIncludedInModel, UpdateSourceTrigger=PropertyChanged}"
                                                Width="35"
                                                IsReadOnly="False">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <EventSetter Event="Checked" Handler="IncludeInModel_Changed"/>
                                    <EventSetter Event="Unchecked" Handler="IncludeInModel_Changed"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#374151"/>
                                    <Setter Property="Foreground" Value="#10B981"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Padding" Value="5,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush" Value="#4B5563"/>
                                    <Setter Property="ToolTip" Value="Include point in model calculation"/>
                                </Style>
                            </DataGridCheckBoxColumn.HeaderStyle>
                        </DataGridCheckBoxColumn>
                        
                        <!-- Column: Index -->
                        <DataGridTextColumn Header="#"
                                              Binding="{Binding Index}"
                                              Width="40"
                                              IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column: Azimuth -->
                        <DataGridTextColumn Header="Az (deg)"
                                              Binding="{Binding Azimuth, StringFormat=F1}"
                                              Width="70"
                                              IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column: Altitude -->
                        <DataGridTextColumn Header="Alt (deg)"
                                              Binding="{Binding Altitude, StringFormat=F1}"
                                              Width="70"
                                              IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column: RA Error (arcsec) - From Plate Solve -->
                        <DataGridTextColumn Header="RA Err (&quot;)"
                                              Binding="{Binding RaErrorDisplay}"
                                              Width="85"
                                              IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="#FCD34D"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RaErrorDisplay}" Value="--">
                                            <Setter Property="Foreground" Value="#6B7280"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column: Dec Error (arcsec) - From Plate Solve -->
                        <DataGridTextColumn Header="Dec Err (&quot;)"
                                              Binding="{Binding DecErrorDisplay}"
                                              Width="85"
                                              IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="#FCD34D"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DecErrorDisplay}" Value="--">
                                            <Setter Property="Foreground" Value="#6B7280"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column: Total Error (arcsec) -->
                        <DataGridTextColumn Header="Total (&quot;)"
                                              Binding="{Binding TotalErrorDisplay}"
                                              Width="80"
                                              IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalErrorDisplay}" Value="--">
                                            <Setter Property="Foreground" Value="#6B7280"/>
                                        </DataTrigger>
                                        <!-- Good: < 10 arcsec -->
                                        <DataTrigger Binding="{Binding IsGoodSolve}" Value="True">
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column: Matched Stars -->
                        <DataGridTextColumn Header="Stars"
                                              Binding="{Binding NumMatchedStarsDisplay}"
                                              Width="55"
                                              IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NumMatchedStarsDisplay}" Value="--">
                                            <Setter Property="Foreground" Value="#6B7280"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column: Status -->
                        <DataGridTextColumn Header="Status"
                                              Binding="{Binding Status}"
                                              Width="95"
                                              IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <!-- Green color for completed/solved points -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="[COMPLETED]">
                                            <Setter Property="Foreground" Value="#10B981"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="[SOLVED]">
                                            <Setter Property="Foreground" Value="#10B981"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <!-- Yellow color for tracking -->
                                        <DataTrigger Binding="{Binding Status}" Value="[TRACKING]">
                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <!-- Yellow color for slewing -->
                                        <DataTrigger Binding="{Binding Status}" Value="[SLEWING]">
                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <!-- Blue for solving -->
                                        <DataTrigger Binding="{Binding Status}" Value="[SOLVING]">
                                            <Setter Property="Foreground" Value="#60A5FA"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <!-- Red for solve failed -->
                                        <DataTrigger Binding="{Binding Status}" Value="[SOLVE FAILED]">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <!-- Control Buttons Below DataGrid -->
            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Row 0: Start/Rerun Buttons -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Button: Start/Resume Toggle -->
                    <Button Grid.Column="0"
                    x:Name="btnStartResume"
                    Content="Start"
                    Click="BtnStartResume_Click"
                    Height="40"
                    Background="#10B981"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#10B981"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#059669"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Button: Save Model -->
                    <Button Grid.Column="4"
                    x:Name="btnSaveModel"
                    Content="Save Model"
                    Click="BtnSaveModel_Click"
                    Height="40"
                    Background="#3B82F6"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    ToolTip="Build and activate a pointing model from the latest solved points">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#4B5563"/>
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Button: Delete Selected Points -->
                    <Button Grid.Column="6"
                    x:Name="btnDeleteSelected"
                    Content="🗑 Delete"
                    Click="BtnDeleteSelected_Click"
                    Height="40"
                    Width="100"
                    Background="#EF4444"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    ToolTip="Delete selected row (click row first to select)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#EF4444"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#4B5563"/>
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                
                <!-- Row 1: Progress Bar (Position 2) -->
                <Border x:Name="progressBarContainer" Grid.Row="1"
                       Background="#2D2D2D" 
                       BorderBrush="#3F3F46" BorderThickness="1"
                        CornerRadius="6" Padding="15,10"
                        Margin="0,10,0,0"
                        Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Row 0: Progress Bar -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Status Text (Dynamic) -->
                            <TextBlock Grid.Column="0" 
                                      x:Name="txtStatusText"
                                      Text="Processing Point 1/40..." 
                                      Foreground="White" FontSize="12" 
                                      FontWeight="SemiBold" 
                                      VerticalAlignment="Center"
                                      Margin="0,0,15,0"/>
                            
                            <!-- Progress Bar with Percentage Inside -->
                            <Grid Grid.Column="1">
                                <ProgressBar x:Name="progressBar"
                                            Height="24"
                                            Minimum="0" Maximum="100" Value="0"
                                            Foreground="#10B981"
                                            Background="#374151"
                                            VerticalAlignment="Center"/>
                                
                                <!-- Percentage Text Inside Progress Bar -->
                                <TextBlock x:Name="txtProgress" 
                                          Text="0%" 
                                          Foreground="White" FontSize="12" 
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                            </Grid>
                            
                            <!-- Completed Count -->
                            <TextBlock Grid.Column="2" 
                                      x:Name="txtCompletedCount"
                                      Text="0/40" 
                                      Foreground="#10B981" FontSize="12" 
                                      FontWeight="Bold"
                                      VerticalAlignment="Center" 
                                      Margin="15,0,0,0"
                                      MinWidth="50"
                                      TextAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                  x:Name="txtEta"
                                  Text="ETA: --"
                                  Foreground="#93C5FD"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Right"
                                  Margin="0,8,0,6"/>
                        
                        <!-- Row 2: RMS Pointing Error Statistics -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Label -->
                            <TextBlock Grid.Column="0" 
                                      x:Name="txtOverallMetricLabel"
                                      Text="Overall RMS Pointing Error:" 
                                      Foreground="#9CA3AF" 
                                      FontSize="11" 
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                            
                            <TextBlock Grid.Column="1"
                                      x:Name="txtOverallMetricDetail"
                                      Text=""
                                      Foreground="#6EE7B7"
                                      FontSize="10"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"/>
                            
                            <!-- RMS Value -->
                            <TextBlock Grid.Column="2" 
                                      x:Name="txtOverallRmsPointingError"
                                      Text="--" 
                                      Foreground="#10B981" 
                                      FontSize="14" 
                                      FontWeight="Bold"
                                      FontFamily="Consolas"
                                      VerticalAlignment="Center"/>
                            
                            <!-- Unit -->
                            <TextBlock Grid.Column="4" 
                                      Text="arcsec" 
                                      Foreground="#9CA3AF" 
                                      FontSize="10"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="3"
                                Background="#1F2937"
                                BorderBrush="#3F3F46"
                                BorderThickness="0,1,0,0"
                                Padding="12,10"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TARGET POSITION"
                                              Foreground="#3B82F6"
                                              FontSize="9"
                                              FontWeight="Bold"
                                              Margin="0,0,0,4"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Az:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtTargetAz" Text="0.00" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="RA:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" x:Name="txtTargetRA" Text="0h 00m 00s" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Alt:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtTargetAlt" Text="0.00" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Dec:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="4" x:Name="txtTargetDec" Text="+00d 00m 00s" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ACTUAL MOUNT POSITION"
                                              Foreground="#10B981"
                                              FontSize="9"
                                              FontWeight="Bold"
                                              Margin="0,0,0,4"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Az:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtMountAz" Text="0.00" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="RA:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" x:Name="txtMountRA" Text="0h 00m 00s" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Alt:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtMountAlt" Text="0.00" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Dec:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="4" x:Name="txtMountDec" Text="+00d 00m 00s" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="TRACKING ERROR &amp; RMS"
                                              Foreground="#EF4444"
                                              FontSize="9"
                                              FontWeight="Bold"
                                              Margin="0,0,0,4"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Az Err:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtErrorAz" Text="0.00" Foreground="#FDE68A" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Az RMS:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" x:Name="txtRmsAz" Text="0.00&quot;&quot;" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Alt Err:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtErrorAlt" Text="0.00" Foreground="#FDE68A" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Alt RMS:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="4" x:Name="txtRmsAlt" Text="0.00&quot;&quot;" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Total RMS:" Foreground="#9CA3AF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="4" x:Name="txtRmsTotal" Text="0.00&quot;&quot;" Foreground="#10B981" FontSize="10" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Right Side: TabControl for Sky Map and Live Image -->
        <Border Grid.Column="2"
                Grid.RowSpan="3"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <TabControl x:Name="rightPanelTabControl"
                        Background="Transparent"
                        BorderThickness="0">
                <TabControl.Resources>
                    <!-- TabControl Style -->
                    <Style TargetType="TabControl">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>

                    <!-- TabItem Style - Same as SettingsWindow -->
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="20,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="0,0,0,2"
                                            BorderBrush="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: Calibration Sky Map -->
                <TabItem Header="Calibration Sky Map">
                    <Grid>
                        <local:CalibrationSkyMap Grid.Row="0"
                                                 x:Name="calibrationSkyMap"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 Margin="10"/>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Live Calibration Image -->
                <TabItem Header="Live Calibration Image">
                    <Grid>
                        <local:LiveCalibrationImageControl x:Name="liveCalibrationImageControl"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>

    </Grid>
</UserControl>
