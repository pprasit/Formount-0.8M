                                                  Stretch="Uniform"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#374151"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="#4B5563"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Drive Control + Enable Button -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Drive Control"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"/>

                                    <Button x:Name="btnToggleAltDrive"
                                            Grid.Column="1"
                                            Content="Enable Drive"
                                            Height="32"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Click="BtnToggleAltDrive_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#059669"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Target Position #1, #2 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Target Pos #1, #2"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"/>

                                    <TextBox x:Name="txtAltTargetPosition1"
                                             Grid.Column="1"
                                             Text="0.0"
                                             Style="{StaticResource ModernTextBox}"
                                             Margin="0,0,3,0"/>

                                    <TextBox x:Name="txtAltTargetPosition2"
                                             Grid.Column="2"
                                             Text="45.0"
                                             Style="{StaticResource ModernTextBox}"
                                             Margin="3,0,3,0"/>

                                    <Button x:Name="btnAltMoveToPosition1"
                                            Grid.Column="3"
                                            Content="#1"
                                            Style="{StaticResource ModernButton}"
                                            Click="BtnAltMoveToPosition1_Click"
                                            Margin="3,0,3,0"/>

                                    <Button x:Name="btnAltMoveToPosition2"
                                            Grid.Column="4"
                                            Content="#2"
                                            Style="{StaticResource ModernButton}"
                                            Click="BtnAltMoveToPosition2_Click"
                                            Margin="3,0,3,0"/>

                                    <TextBlock Grid.Column="5"
                                               Text="deg"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"/>
                                </Grid>

                                <!-- Velocity -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Velocity"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"/>

                                    <TextBox x:Name="txtAltMoveVelocity"
                                             Grid.Column="1"
                                             Text="1.0"
                                             Style="{StaticResource ModernTextBox}"
                                             Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="deg/s"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"/>
                                </Grid>

                                <!-- Move to Position #1 Button -->
                                <Button x:Name="btnAltMoveToPosition"
                                        Content="Move to Position #1"
                                        Height="32"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource ModernButton}"
                                        Click="BtnAltMoveToPosition_Click"
                                        Margin="0,0,0,10"/>

                                <!-- Stop Motion Button -->
                                <Button x:Name="btnAltStopMotion"
                                        Content="Stop Motion"
                                        Height="32"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Click="BtnAltStopMotion_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                            <Setter Property="Background" Value="{StaticResource ErrorRed}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Velocity Control Section -->
                        <Border Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource WarningOrange}"
                                            Width="3"
                                            Height="20"
                                            CornerRadius="2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Velocity Control"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Target Velocity -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Target Velocity"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"/>

                                    <TextBox x:Name="txtAltTargetVelocity"
                                             Grid.Column="1"
                                             Text="0.0"
                                             Style="{StaticResource ModernTextBox}"
                                             Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="deg/s"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"/>
                                </Grid>

                                <!-- Move Velocity Button -->
                                <Button x:Name="btnAltMoveVelocity"
                                        Content="Move Velocity"
                                        Height="32"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource ModernButton}"
                                        Click="BtnAltMoveVelocity_Click"
                                        Margin="0,0,0,10"/>

                                <!-- Stop Velocity Button -->
                                <Button x:Name="btnAltStopVelocity"
                                        Content="Stop Velocity"
                                        Height="32"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Click="BtnAltStopVelocity_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                            <Setter Property="Background" Value="{StaticResource ErrorRed}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Right Panel: Chart -->
        <local:AltitudeChartPanel x:Name="chartPanel"
                                  Grid.Column="1"
                                  Margin="0,0,0,0"/>
    </Grid>
</UserControl>
