<Window x:Class="ForkMount_WPF.UI.CollimationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collimation Result"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModernComboBox style matching other windows -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#9CA3AF"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#374151"
                                            BorderBrush="#4B5563"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="4,4,4,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#252526"
                    BorderBrush="#3F3F46" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock Text="&#x1F52D; Collimation Result"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button Content="&#x2715;" HorizontalAlignment="Right"
                            Click="BtnClose_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="40" Height="36" FontSize="11"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="16,12,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP: Two columns - Left: Score+Metrics, Right: Diagram -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Score + Metrics -->
                    <StackPanel Grid.Column="0">
                        <!-- Score Circle -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse x:Name="scoreRing" Width="100" Height="100"
                                     StrokeThickness="6" Fill="Transparent"/>
                            <Ellipse Width="84" Height="84"
                                     Stroke="#2D2D30" StrokeThickness="4" Fill="Transparent"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtScoreValue" Text="95%"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Collimation"
                                           FontSize="8" Foreground="#9CA3AF"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Quality Badge -->
                        <Border x:Name="qualityBadge"
                                Background="#10B981" CornerRadius="10"
                                HorizontalAlignment="Center"
                                Padding="14,4" Margin="0,0,0,10">
                            <TextBlock x:Name="txtQualityBadge" Text="Excellent"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>

                        <!-- Metrics Grid -->
                        <Border Background="#2D2D30" CornerRadius="6"
                                BorderBrush="#3F3F46" BorderThickness="1"
                                Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="FWHM"
                                           Foreground="#9CA3AF" FontSize="10" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           x:Name="txtFWHM" Text="--"
                                           Foreground="#10B981" FontSize="11"
                                           FontFamily="Consolas" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Text="Roundness"
                                           Foreground="#9CA3AF" FontSize="10" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           x:Name="txtRoundness" Text="--"
                                           Foreground="#10B981" FontSize="11"
                                           FontFamily="Consolas" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="2" Text="Eccentricity"
                                           Foreground="#9CA3AF" FontSize="10" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           x:Name="txtEccentricity" Text="--"
                                           Foreground="#10B981" FontSize="11"
                                           FontFamily="Consolas" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="3" Text="Stars"
                                           Foreground="#9CA3AF" FontSize="10"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           x:Name="txtStars" Text="--"
                                           Foreground="White" FontSize="11"
                                           FontFamily="Consolas" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <!-- Next Adjustment (compact) -->
                        <Border Background="#2D2D30" CornerRadius="6"
                                BorderBrush="#3F3F46" BorderThickness="1"
                                Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="NEXT ADJUSTMENT"
                                           Foreground="#8B5CF6" FontSize="9"
                                           FontWeight="Bold" Margin="0,0,0,5"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Screw:"
                                               Foreground="#9CA3AF" FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="1"
                                              x:Name="cmbNextScrew"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="CmbNextScrew_SelectionChanged"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="A" Tag="A"/>
                                        <ComboBoxItem Content="B" Tag="B"/>
                                        <ComboBoxItem Content="C" Tag="C"/>
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Direction:"
                                               Foreground="#9CA3AF" FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="1"
                                              x:Name="cmbNextDirection"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Tighten (CW)" Tag="Tighten"/>
                                        <ComboBoxItem Content="Loosen (CCW)" Tag="Loosen"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Mirror Diagram -->
                    <Border Grid.Column="2"
                            Background="#2D2D30" CornerRadius="6"
                            BorderBrush="#3F3F46" BorderThickness="1"
                            Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="MIRROR ADJUSTMENT SCREWS"
                                       Foreground="#F59E0B" FontSize="9"
                                       FontWeight="Bold" Margin="0,0,0,5"/>

                            <!-- Screw A angle: Slider + TextBox -->
                            <Grid Grid.Row="1" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="A:"
                                           Foreground="#9CA3AF" FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <Slider Grid.Column="1"
                                        x:Name="sliderScrewA"
                                        Minimum="0" Maximum="359" Value="0"
                                        VerticalAlignment="Center"
                                        ValueChanged="SliderScrewA_ValueChanged"/>
                                <TextBox Grid.Column="2"
                                         x:Name="txtScrewAAngle"
                                         Style="{StaticResource SmallTextBox}"
                                         Text="0"
                                         Margin="4,0,0,0"
                                         LostFocus="TxtScrewAAngle_LostFocus"
                                         MaxLength="3"/>
                                <TextBlock Grid.Column="3"
                                           Text="&#x00B0;"
                                           Foreground="#9CA3AF" FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"/>
                            </Grid>

                            <!-- Canvas Diagram -->
                            <Border Grid.Row="2" Background="#1A1A1A" CornerRadius="5"
                                    BorderBrush="#3F3F46" BorderThickness="1">
                                <Canvas x:Name="diagramCanvas"
                                        ClipToBounds="True"/>
                            </Border>

                            <!-- Legend -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,5,0,0">
                                <Ellipse Width="7" Height="7" Fill="#EF4444"
                                         VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="A" Foreground="#EF4444"
                                           FontSize="9" FontWeight="Bold"
                                           Margin="0,0,10,0"/>
                                <Ellipse Width="7" Height="7" Fill="#3B82F6"
                                         VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="B" Foreground="#3B82F6"
                                           FontSize="9" FontWeight="Bold"
                                           Margin="0,0,10,0"/>
                                <Ellipse Width="7" Height="7" Fill="#10B981"
                                         VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="C" Foreground="#10B981"
                                           FontSize="9" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- HINT (compact, full width) -->
                <Border x:Name="hintPanel" Grid.Row="1"
                        Background="#2D2D30" CornerRadius="6"
                        BorderBrush="#3F3F46" BorderThickness="1"
                        Padding="12,8" Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HINT"
                                   Foreground="#F59E0B" FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Top"
                                   Margin="0,2,10,0"/>
                        <TextBlock Grid.Column="1" x:Name="txtHint"
                                   Foreground="#CCCCCC" FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </Grid>
                </Border>

                <!-- BOTTOM: Action Buttons -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Further Adjust"
                            Click="BtnFurtherAdjustment_Click"
                            Background="#8B5CF6"
                            Style="{StaticResource RoundedButton}"
                            ToolTip="Save result and screw position, close window to let you adjust screws, then re-test"/>

                    <Button Grid.Column="2" Content="Finish"
                            Click="BtnFinish_Click"
                            Background="#10B981"
                            Style="{StaticResource RoundedButton}"
                            ToolTip="Save screw position and finish the collimation session"/>

                    <Button Grid.Column="4" Content="Close"
                            Click="BtnClose_Click"
                            Background="#4B5563"
                            Style="{StaticResource RoundedButton}"
                            ToolTip="Close without saving"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
