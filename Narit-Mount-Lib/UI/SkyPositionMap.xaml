<UserControl x:Class="ForkMount_WPF.UI.SkyPositionMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">

    <UserControl.Resources>
        <SolidColorBrush x:Key="MapBackground" Color="#171921"/>
        <SolidColorBrush x:Key="GridLine" Color="#4B5563"/>
        <SolidColorBrush x:Key="GridLineLight" Color="#6B7280"/>
        <SolidColorBrush x:Key="MarkerFill" Color="#10B981"/>
        <SolidColorBrush x:Key="TextColor" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="LabelColor" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
    </UserControl.Resources>

    <Border Background="{StaticResource MapBackground}"
            CornerRadius="10"
            BorderBrush="#2D3748"
            BorderThickness="1"
            Padding="15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.3" ShadowDepth="2" BlurRadius="10"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Sky Position Map"
                       Foreground="{StaticResource TextColor}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <!-- Mount Status Display -->
            <Border Grid.Row="0"
                    Background="#1F2937"
                    BorderBrush="#2D3748"
                    BorderThickness="1"
                    CornerRadius="5"
                    Height="24"
                    Padding="8,0"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: "
                               Foreground="{StaticResource LabelColor}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <Ellipse x:Name="mountStatusIndicator"
                             Width="6" Height="6"
                             Fill="#6B7280"
                             Margin="0,0,4,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtMountStatus"
                               Text="Disabled"
                               Foreground="{StaticResource TextColor}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Azimuth Info Display (A1 - Bottom Left of canvas) -->
            <Border Canvas.Left="10"
        Canvas.Bottom="10"
        Background="#1A1F2E"
        BorderBrush="#2D3748"
        BorderThickness="1"
        CornerRadius="6"
        Padding="10,8"
        Opacity="0.95"
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                <StackPanel>
                    <TextBlock Text="Azimuth"
                   Foreground="{StaticResource LabelColor}"
                   FontSize="9"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtAzimuth"
                       Text="0.0&#xB0;"
                       Foreground="{StaticResource TextColor}"
                       FontSize="14"
                       FontWeight="Bold"
                       FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAzimuthVelocity"
                   Text="0.000 deg/s"
                   Foreground="#3B82F6"
                   FontSize="10"
                   FontFamily="Consolas"
                   HorizontalAlignment="Left"
                   Margin="0,2,0,0"/>
                    
                    <!-- RMS Error Display -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="RMS: "
                                 Foreground="{StaticResource LabelColor}"
                                 FontSize="9"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtAzimuthRms"
                                 Text="--"
                                 Foreground="#F59E0B"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 FontFamily="Consolas"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text=" &quot;"
                                 Foreground="{StaticResource LabelColor}"
                                 FontSize="9"
                                 Margin="1,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Altitude Info Display (B1 - Bottom Right of canvas) -->
            <Border Canvas.Right="10"
        Canvas.Bottom="10"
        Background="#1A1F2E"
        BorderBrush="#2D3748"
        BorderThickness="1"
        CornerRadius="6"
        Padding="10,8"
        Opacity="0.95"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
                <StackPanel>
                    <TextBlock Text="Altitude"
                   Foreground="{StaticResource LabelColor}"
                   FontSize="9"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtAltitude"
                       Text="0.0&#xB0;"
                       Foreground="{StaticResource TextColor}"
                       FontSize="14"
                       FontWeight="Bold"
                       FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock x:Name="txtAltitudeVelocity"
                   Text="0.000 deg/s"
                   Foreground="#10B981"
                   FontSize="10"
                   FontFamily="Consolas"
                   HorizontalAlignment="Left"
                   Margin="0,2,0,0"/>
                    
                    <!-- RMS Error Display -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="RMS: "
                                 Foreground="{StaticResource LabelColor}"
                                 FontSize="9"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtAltitudeRms"
                                 Text="--"
                                 Foreground="#F59E0B"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 FontFamily="Consolas"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text=" &quot;"
                                 Foreground="{StaticResource LabelColor}"
                                 FontSize="9"
                                 Margin="1,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Viewbox Grid.Row="1" Stretch="Uniform">
                <Canvas x:Name="skyCanvas"
                        Width="360"
                        Height="360"
                        Background="Transparent"
                        Margin="20">

                    <Ellipse Width="340" Height="340"
                             Stroke="{StaticResource GridLine}"
                             StrokeThickness="2"
                             Canvas.Left="10"
                             Canvas.Top="10"/>

                    <Ellipse Width="227" Height="227"
                             Stroke="{StaticResource GridLine}"
                             StrokeThickness="1.5"
                             StrokeDashArray="4,2"
                             Canvas.Left="66.5"
                             Canvas.Top="66.5"/>

                    <Ellipse Width="113" Height="113"
                             Stroke="{StaticResource GridLine}"
                             StrokeThickness="1.5"
                             StrokeDashArray="4,2"
                             Canvas.Left="123.5"
                             Canvas.Top="123.5"/>

                    <Ellipse Width="6" Height="6"
                             Fill="{StaticResource GridLine}"
                             Canvas.Left="177"
                             Canvas.Top="177"/>

                    <Line X1="180" Y1="10" X2="180" Y2="350"
                          Stroke="{StaticResource GridLine}"
                          StrokeThickness="1"
                          StrokeDashArray="2,2"/>

                    <Line X1="10" Y1="180" X2="350" Y2="180"
                          Stroke="{StaticResource GridLine}"
                          StrokeThickness="1"
                          StrokeDashArray="2,2"/>

                    <TextBlock Text="0&#xB0;"
                               Foreground="{StaticResource GridLine}"
                               FontSize="14"
                               FontWeight="Bold"
                               Canvas.Left="176"
                               Canvas.Top="-8"/>
                    <TextBlock Text="N"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="12"
                               Canvas.Left="175"
                               Canvas.Top="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <TextBlock Text="90&#xB0;"
                               Foreground="{StaticResource GridLine}"
                               FontSize="14"
                               FontWeight="Bold"
                               Canvas.Left="355"
                               Canvas.Top="169" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Text="E"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="12"
                               Canvas.Left="334"
                               Canvas.Top="171" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <TextBlock Text="180&#xB0;"
                               Foreground="{StaticResource GridLine}"
                               FontSize="14"
                               FontWeight="Bold"
                               Canvas.Left="165"
                               Canvas.Top="355"/>
                    <TextBlock Text="S"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="12"
                               Canvas.Left="176"
                               Canvas.Top="329" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <TextBlock Text="270&#xB0;"
                               Foreground="{StaticResource GridLine}"
                               FontSize="14"
                               FontWeight="Bold"
                               Canvas.Left="-24"
                               Canvas.Top="169" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock Text="W"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="12"
                               Canvas.Left="23"
                               Canvas.Top="171" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <!-- Elevation Labels -->
                    <TextBlock Text="30&#xB0;"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="10"
                               Canvas.Left="248"
                               Canvas.Top="106" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="60&#xB0;"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="10"
                               Canvas.Left="207"
                               Canvas.Top="146" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <!-- CW Limit Line (Red, initially hidden) -->
                    <Line x:Name="cwLimitLine"
                          X1="180" Y1="180"
                          X2="180" Y2="10"
                          Stroke="#EF4444"
                          StrokeThickness="3"
                          StrokeDashArray="6,4"
                          Opacity="0.8"
                          Visibility="Collapsed">
                        <Line.Effect>
                            <DropShadowEffect Color="#EF4444" Opacity="0.6" ShadowDepth="0" BlurRadius="8"/>
                        </Line.Effect>
                    </Line>

                    <!-- CCW Limit Line (Red, initially hidden) -->
                    <Line x:Name="ccwLimitLine"
                          X1="180" Y1="180"
                          X2="180" Y2="10"
                          Stroke="#EF4444"
                          StrokeThickness="3"
                          StrokeDashArray="6,4"
                          Opacity="0.8"
                          Visibility="Collapsed">
                        <Line.Effect>
                            <DropShadowEffect Color="#EF4444" Opacity="0.6" ShadowDepth="0" BlurRadius="8"/>
                        </Line.Effect>
                    </Line>

                    <!-- CW Limit Label -->
                    <TextBlock x:Name="cwLimitLabel"
                               Text="CW LIMIT"
                               Foreground="#EF4444"
                               FontSize="9"
                               FontWeight="Bold"
                               Canvas.Left="190"
                               Canvas.Top="20"
                               Visibility="Collapsed">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#EF4444" Opacity="0.8" ShadowDepth="0" BlurRadius="6"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- CCW Limit Label -->
                    <TextBlock x:Name="ccwLimitLabel"
                               Text="CCW LIMIT"
                               Foreground="#EF4444"
                               FontSize="9"
                               FontWeight="Bold"
                               Canvas.Left="190"
                               Canvas.Top="20"
                               Visibility="Collapsed">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#EF4444" Opacity="0.8" ShadowDepth="0" BlurRadius="6"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Current Position Marker (keep on top) -->
                    <Ellipse x:Name="positionMarker"
                             Width="12"
                             Height="12"
                             Fill="{StaticResource MarkerFill}"
                             Stroke="White"
                             StrokeThickness="2"
                             Canvas.Left="174"
                             Canvas.Top="174">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#10B981"
                                            Opacity="0.8"
                                            ShadowDepth="0"
                                            BlurRadius="10"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Position Line (from center to marker) -->
                    <Line x:Name="positionLine"
                          X1="180" Y1="180"
                          X2="180" Y2="180"
                          Stroke="{StaticResource MarkerFill}"
                          StrokeThickness="2"
                          StrokeDashArray="3,2"
                          Opacity="0.6"/>

                    <!-- Satellite Trajectory Path (Orange, dashed line) -->
                    <Polyline x:Name="trajectoryPath"
                              Stroke="#F97316"
                              StrokeThickness="2"
                              StrokeDashArray="4,2"
                              Opacity="0.8"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                        <Polyline.Effect>
                            <DropShadowEffect Color="#F97316" Opacity="0.4" ShadowDepth="0" BlurRadius="6"/>
                        </Polyline.Effect>
                    </Polyline>

                    <!-- Satellite Position Markers (Triangles) on trajectory -->
                    <Canvas x:Name="trajectoryMarkers"/>
                </Canvas>
            </Viewbox>

            <Border Grid.Row="2"
                    Background="#1A1F2E"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
                <!-- Hidden original info display -->
            </Border>
        </Grid>
    </Border>
</UserControl>
