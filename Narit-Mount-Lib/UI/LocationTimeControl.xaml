<UserControl x:Class="ForkMount_WPF.UI.LocationTimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Border"
                                    Width="20"
                                    Height="20"
                                    Background="#374151"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Margin="0,0,10,0">
                                <Path x:Name="CheckMark"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Fill="#10B981"
                                      Data="M0,5 L4,9 L12,0"
                                      Stroke="#10B981"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Border" Property="Background" Value="#1F2937"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="550" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <!-- Observer Location Section -->
            <Border Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,15">
                <!-- Left: Location Form -->
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Observer Location"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,15"/>

                    <!-- Search Location -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                       Text="Search:"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSearchLocation"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Text=""
                                     KeyDown="TxtSearchLocation_KeyDown"/>
                        <Button x:Name="btnSearch"
                                    Grid.Column="2"
                                    Content="🔍"
                                    Click="BtnSearch_Click"
                                    Width="40"
                                    Height="36"
                                    Margin="10,0,0,0"
                                    Background="#3B82F6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="16"
                                    Cursor="Hand"
                                    ToolTip="Search location"
                                HorizontalAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Location Name -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                       Text="Location Name:"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLocationName"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="Chiang Mai, Thailand"/>
                    </Grid>

                    <!-- Latitude -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                       Text="Latitude:"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLatitude"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="18.852638"
                                     TextChanged="LocationTextBox_TextChanged"/>
                        <TextBlock Grid.Column="2"
                                       Text="deg"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Longitude -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                       Text="Longitude:"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLongitude"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="98.958352"
                                     TextChanged="LocationTextBox_TextChanged"/>
                        <TextBlock Grid.Column="2"
                                       Text="deg"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Elevation -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                       Text="Elevation:"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        <TextBox x:Name="txtElevation"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="350"/>
                        <TextBlock Grid.Column="2"
                                       Text="meters"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                    </Grid>

                    <!-- UTC Timezone Offset -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                       Text="Timezone:"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbTimezone"
                                  Grid.Column="1"
                                  Style="{DynamicResource ModernComboBox}"
                                  SelectionChanged="CmbTimezone_SelectionChanged"/>
                    </Grid>

                    <!-- Current Time Display -->
                    <Border Background="#1F2937"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,5,0,0">
                        <StackPanel>
                            <!-- UTC Time -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="UTC Time:"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <TextBlock x:Name="txtUtcTime"
                                           Grid.Column="1"
                                           Text="--:--:--"
                                           Foreground="#60A5FA"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Local Time -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtLocalTimeLabel"
                                           Grid.Column="0"
                                           Text="Local Time (UTC+7):"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <TextBlock x:Name="txtLocalTime"
                                           Grid.Column="1"
                                           Text="--:--:--"
                                           Foreground="#10B981"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Hint Text -->
                    <TextBlock Text="Click on the map to set location"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="#9CA3AF"
                                   Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBackground}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     CornerRadius="8"
                     Padding="20"
                     Margin="15,0,0,0"
                     Grid.Column="1"
                    Grid.RowSpan="2">
                <!-- Right: Interactive Map -->
                <Border Grid.Column="1"
            Background="#1F2937"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
                    <Grid>
                        <!-- Map Container -->
                        <Border x:Name="mapContainer"
                    Background="#1F2937"
                    CornerRadius="8">
                            <!-- WebView2 will be added here in code-behind -->
                        </Border>

                        <!-- Loading Overlay -->
                        <Border x:Name="mapLoadingOverlay"
                    Background="#1F2937"
                    CornerRadius="8"
                    Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                                <TextBlock Text="Loading Map..."
                              FontSize="14"
                              Foreground="{StaticResource TextSecondary}"
                              HorizontalAlignment="Center"/>
                                <TextBlock Text="🗺️"
                              FontSize="48"
                              HorizontalAlignment="Center"
                              Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Border>
            <!-- NTP Time Server Section -->
            <Border Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Grid.Row="1">
                <StackPanel>
                    <TextBlock Text="Time Synchronization (NTP)"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,15"/>

                    <!-- Enable NTP -->
                    <CheckBox x:Name="chkEnableNtp"
                              Content="Enable NTP Synchronization"
                              Style="{StaticResource ModernCheckBox}"
                              IsChecked="True"
                              Margin="0,0,0,12"/>

                    <!-- NTP Server Address -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="NTP Server:"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtNtpServer"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="pool.ntp.org"
                                 IsEnabled="{Binding IsChecked, ElementName=chkEnableNtp}"/>
                    </Grid>

                    <!-- Sync Interval -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Sync Interval:"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSyncInterval"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="60"
                                 IsEnabled="{Binding IsChecked, ElementName=chkEnableNtp}"/>
                        <TextBlock Grid.Column="2"
                                   Text="minutes"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
