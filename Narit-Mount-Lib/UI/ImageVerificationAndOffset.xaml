<Window x:Class="ForkMount_WPF.UI.ImageVerificationAndOffset"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:ForkMount_WPF.UI"
Title="Image Verification and Offset"
        Width="1400" Height="900"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="DarkBackground" Color="#0F1419"/>
        <SolidColorBrush x:Key="CardBackground" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="Foreground" Value="#4B5563"/>
                    <Setter Property="BorderBrush" Value="#2D3748"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#374151"
                                            BorderBrush="#4B5563"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="Foreground" Value="#4B5563"/>
                    <Setter Property="BorderBrush" Value="#2D3748"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slim ScrollBar for thumbnail gallery -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#55FFFFFF"
                                                                CornerRadius="3"
                                                                Margin="0,1"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#1E1E1E"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="Camera and Offset"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Camera Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="statusIndicator"
                                 Width="8" Height="8"
                                 Fill="#EF4444"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtCameraStatus"
                                   Text="Not Connected"
                                   Foreground="#9CA3AF"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="―"
                                Click="BtnMinimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="☐"
                                Click="BtnMaximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="✕"
                                Click="BtnClose_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content: Left = Preview, Right = Controls -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Image Preview -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Preview Header -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="Image Preview"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtImageInfo"
                                           Text=""
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="txtZoomInfo"
                                           Text="Zoom: 100%"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Button x:Name="btn1to1"
                                        Click="BtnReset1to1_Click"
                                        Style="{StaticResource ModernButton}"
                                        Background="#6B7280"
                                        Height="26" Padding="10,0"
                                        Margin="0,0,5,0"
                                        ToolTip="1:1 scale (100%)">
                                    <TextBlock Text="1:1" FontSize="10" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="btnFitWindow"
                                        Click="BtnResetZoom_Click"
                                        Style="{StaticResource ModernButton}"
                                        Background="#4B5563"
                                        Height="26" Padding="10,0"
                                        ToolTip="Fit to window">
                                    <TextBlock Text="Fit" FontSize="10" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Image Display -->
                        <Border Grid.Row="1" x:Name="borderPreview"
                                BorderBrush="#3F3F46" BorderThickness="1"
                                CornerRadius="6" Background="#1A1A1A"
                                ClipToBounds="True"
                                SizeChanged="BorderPreview_SizeChanged">
                            <Grid>
                                <ScrollViewer x:Name="scrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent">
                                    <Grid>
                                        <Image x:Name="imgPreview"
                                               Stretch="None"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               MouseWheel="ImgPreview_MouseWheel"
                                               MouseLeftButtonDown="ImgPreview_MouseLeftButtonDown"
                                               MouseLeftButtonUp="ImgPreview_MouseLeftButtonUp"
                                               MouseMove="ImgPreview_MouseMove"
                                               MouseLeave="ImgPreview_MouseLeave"
                                               Cursor="Hand"/>
                                        <!-- Star detection overlay -->
                                        <Canvas x:Name="starOverlay"
                                                Background="Transparent"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </ScrollViewer>

                                <!-- No Image Placeholder -->
                                <TextBlock x:Name="txtPlaceholder"
                                           Text="No image captured yet&#10;&#10;Use Test Capture to take a photo"
                                           Foreground="#6B7280"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- Loading Overlay -->
                                <Grid x:Name="loadingPanel" Visibility="Collapsed"
                                      Background="#AA000000">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Capturing..."
                                                   Foreground="White"
                                                   FontSize="16" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtCountdown"
                                                   Text="0.000 s"
                                                   Foreground="#10B981"
                                                   FontSize="24" FontWeight="Bold"
                                                   FontFamily="Consolas"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="200" Height="4"
                                                     Margin="0,10,0,0"
                                                     Foreground="#3B82F6"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- FOV Info + Capture Status -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top Row: FOV + Status -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock x:Name="txtFOVInfo"
                                           Text="FOV: --"
                                           Foreground="#10B981"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Ellipse x:Name="captureStatusDot"
                                             Width="7" Height="7"
                                             Fill="#6B7280"
                                             VerticalAlignment="Center"
                                             Margin="0,0,5,0"/>
                                    <TextBlock x:Name="txtCaptureStatus"
                                               Text="Idle"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Thumbnail Gallery -->
                            <Border Grid.Row="1"
                                    Background="#1A1A1A"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="120">
                                <Grid>
                                    <ScrollViewer x:Name="thumbnailScrollViewer"
                                                  HorizontalScrollBarVisibility="Visible"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  Padding="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                                        </ScrollViewer.Resources>
                                        <ItemsControl x:Name="thumbnailGallery">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#252526"
                                                            BorderThickness="2"
                                                            CornerRadius="4"
                                                            Width="80"
                                                            Height="80"
                                                            Margin="4"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="Thumbnail_Click"
                                                            Tag="{Binding}">
                                                        <Border.ToolTip>
                                                            <ToolTip Background="#2D2D30" 
                                                                     BorderBrush="#3F3F46" 
                                                                     BorderThickness="1">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding TooltipText}" 
                                                                               Foreground="White" 
                                                                               FontSize="11"
                                                                               LineHeight="16"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{Binding DisplayBorderBrush}"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Image Source="{Binding Thumbnail}"
                                                                   Stretch="Uniform"
                                                                   Margin="2"/>
                                                            <!-- Image ID Badge -->
                                                            <Border Background="#AA000000"
                                                                    CornerRadius="2"
                                                                    Padding="4,2"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="4">
                                                                <TextBlock Text="{Binding Id}"
                                                                           Foreground="White"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                            <!-- Selected Checkmark Badge -->
                                                            <Border Background="#10B981"
                                                                    CornerRadius="2"
                                                                    Width="16" Height="16"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="0,0,4,4">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="✓"
                                                                           Foreground="White"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Empty State -->
                                    <TextBlock x:Name="txtThumbnailPlaceholder"
                                               Text="📷 Captured images will appear here"
                                               Foreground="#6B7280"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Visible"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT: Tabbed Controls -->
                <Border Grid.Column="2"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <TabControl x:Name="MainTab" Background="Transparent" BorderThickness="0" SelectionChanged="MainTab_SelectionChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabControl">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="16,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0,0,0,2"
                                                    BorderBrush="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- TAB 1: Camera Control -->
                        <TabItem Header="Camera">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,8,0,0">
                                <StackPanel Margin="4,0">
                                    <!-- Camera + Exposure + Gain + Binning + ImageType in compact Grid -->
                                    <Grid x:Name="gridCameraSettings" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Camera -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="Camera"
                                                   Foreground="#3B82F6"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                  x:Name="cmbCamera"
                                                  Style="{StaticResource ModernComboBox}"
                                                  Height="28"
                                                  Margin="0,0,0,8"
                                                  SelectionChanged="CmbCamera_SelectionChanged"/>

                                        <!-- Row 1: Exposure -->
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="Exposure"
                                                   Foreground="#3B82F6"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 x:Name="txtExposureTime"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="1000" Padding="6,4"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                   Text="ms"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,8"/>

                                        <!-- Row 2: Gain -->
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="Gain"
                                                   Foreground="#3B82F6"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                              Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="sliderGain"
                                                    Minimum="0" Maximum="600" Value="0"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="SliderGain_ValueChanged"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="txtGain"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="0" Margin="4,0,0,0"
                                                     Padding="4,4"
                                                     TextChanged="TxtGain_TextChanged"/>
                                        </Grid>

                                        <!-- Row 3: Binning -->
                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Text="Binning"
                                                   Foreground="#3B82F6"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                  x:Name="cmbBinning"
                                                  Style="{StaticResource ModernComboBox}"
                                                  Height="28"
                                                  Margin="0,0,0,8"
                                                  SelectionChanged="CmbBinning_SelectionChanged">
                                            <ComboBoxItem Content="1x1" Tag="1" IsSelected="True"/>
                                            <ComboBoxItem Content="2x2" Tag="2"/>
                                            <ComboBoxItem Content="3x3" Tag="3"/>
                                            <ComboBoxItem Content="4x4" Tag="4"/>
                                        </ComboBox>

                                        <!-- Row 4: Image Type -->
                                        <TextBlock Grid.Row="4" Grid.Column="0"
                                                   Text="Type"
                                                   Foreground="#3B82F6"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                  x:Name="cmbImageType"
                                                  Style="{StaticResource ModernComboBox}"
                                                  Height="28"
                                                  SelectionChanged="CmbImageType_SelectionChanged">
                                            <ComboBoxItem Content="RAW8" Tag="0"/>
                                            <ComboBoxItem Content="RGB24" Tag="1"/>
                                            <ComboBoxItem Content="RAW16 ⭐" Tag="2" IsSelected="True"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Cooler: inline row -->
                                    <Grid x:Name="gridCoolerRow" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  x:Name="chkCoolerOn"
                                                  Content="Cooler"
                                                  Foreground="#3B82F6"
                                                  FontSize="11" FontWeight="Bold"
                                                  VerticalContentAlignment="Center"
                                                  Checked="ChkCoolerOn_Changed"
                                                  Unchecked="ChkCoolerOn_Changed"
                                                  Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="txtCoolerStatus"
                                                   Text=""
                                                   Foreground="#6EE7B7"
                                                   FontSize="9"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2"
                                                 x:Name="txtCoolerTemp"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="-10"
                                                 Padding="4,4"
                                                 LostFocus="TxtCoolerTemp_LostFocus"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="°C"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </Grid>

                                    <Border Height="1" Background="#3F3F46" Margin="0,10,0,10"/>

                                    <!-- Capture -->
                                    <Button x:Name="btnTestCapture"
                                            Click="BtnTestCapture_Click"
                                            Style="{StaticResource ModernButton}"
                                            Background="#10B981"
                                            Height="34"
                                            Padding="10,0"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,10">
                                        <TextBlock Text="Capture" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Histogram Stretch -->
                                    <Border Background="#2D2D30"
                                            BorderBrush="#3F3F46"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,10">
                                        <StackPanel>
                                            <TextBlock Text="HISTOGRAM STRETCH"
                                                       Foreground="#F59E0B"
                                                       FontSize="10" FontWeight="Bold"
                                                       Margin="0,0,0,8"/>

                                            <!-- Profile: label + combo inline -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Profile"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1"
                                                          x:Name="cmbStretchProfile"
                                                          Style="{StaticResource ModernComboBox}"
                                                          Height="26"
                                                          SelectionChanged="CmbStretchProfile_SelectionChanged">
                                                    <ComboBoxItem Content="Auto" Tag="0" IsSelected="True"/>
                                                    <ComboBoxItem Content="Low (Bright)" Tag="1"/>
                                                    <ComboBoxItem Content="Medium" Tag="2"/>
                                                    <ComboBoxItem Content="High (Faint)" Tag="3"/>
                                                    <ComboBoxItem Content="Manual" Tag="4"/>
                                                    <ComboBoxItem Content="Bright Stars" Tag="5"/>
                                                    <ComboBoxItem Content="Moon" Tag="6"/>
                                                    <ComboBoxItem Content="Planet" Tag="7"/>
                                                    <ComboBoxItem Content="Deep Sky" Tag="8"/>
                                                </ComboBox>
                                            </Grid>

                                            <TextBlock x:Name="txtProfileInfo"
                                                       Text=""
                                                       Foreground="#6EE7B7"
                                                       FontSize="9"
                                                       Margin="0,0,0,6"/>

                                            <!-- Black: label + slider + value inline -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="45"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Black"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1"
                                                        x:Name="sliderHistogramMin"
                                                        Minimum="0" Maximum="65535" Value="0"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="SliderHistogram_ValueChanged"
                                                        PreviewMouseLeftButtonUp="SliderHistogram_MouseUp"/>
                                                <TextBlock Grid.Column="2"
                                                           x:Name="txtHistogramMin"
                                                           Text="0"
                                                           Foreground="White"
                                                           FontSize="10" FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- White: label + slider + value inline -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="45"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="White"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1"
                                                        x:Name="sliderHistogramMax"
                                                        Minimum="0" Maximum="65535" Value="65535"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="SliderHistogram_ValueChanged"
                                                        PreviewMouseLeftButtonUp="SliderHistogram_MouseUp"/>
                                                <TextBlock Grid.Column="2"
                                                           x:Name="txtHistogramMax"
                                                           Text="65535"
                                                           Foreground="White"
                                                           FontSize="10" FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Auto Save FITS -->
                                    <local:AutoSaveFitsControl x:Name="autoSaveFitsControl"
                                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: Telescope Offset -->
                        <TabItem Header="Colimation - Offset">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,8,0,0">
                                <StackPanel Margin="4,0">
                                    <!-- Offset Type -->
                                    <TextBlock Text="OFFSET TYPE"
                                               Foreground="#3B82F6"
                                               FontSize="11" FontWeight="Bold"
                                               Margin="0,0,0,8"/>

                                    <ComboBox x:Name="cmbOffsetType"
                                              Style="{StaticResource ModernComboBox}"
                                              Height="32"
                                              Margin="0,0,0,15">
                                        <ComboBoxItem Content="RA / Dec" Tag="RaDec" IsSelected="True"/>
                                        <ComboBoxItem Content="Alt / Azm" Tag="AltAzm"/>
                                    </ComboBox>

                                    <TextBlock Text="OFFSET STEP SIZE"
                                               Foreground="#F59E0B"
                                               FontSize="11" FontWeight="Bold"
                                               Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtOffsetStep"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="10"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="arcsec"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="DIRECTION"
                                               Foreground="#3B82F6"
                                               FontSize="11" FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <!-- 3x3 Directional Grid -->
                                    <Grid HorizontalAlignment="Center" Margin="0,0,0,15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50"/>
                                            <RowDefinition Height="50"/>
                                            <RowDefinition Height="50"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0"
                                                Content="↖" FontSize="18"
                                                Click="BtnOffset_Click" Tag="NW"
                                                Style="{StaticResource ModernButton}"
                                                Background="#374151" Padding="0"
                                                Margin="2" ToolTip="Up-Left"/>
                                        <Button Grid.Row="0" Grid.Column="1"
                                                Content="↑" FontSize="18"
                                                Click="BtnOffset_Click" Tag="N"
                                                Style="{StaticResource ModernButton}"
                                                Background="#374151" Padding="0"
                                                Margin="2" ToolTip="Up"/>
                                        <Button Grid.Row="0" Grid.Column="2"
                                                Content="↗" FontSize="18"
                                                Click="BtnOffset_Click" Tag="NE"
                                                Style="{StaticResource ModernButton}"
                                                Background="#374151" Padding="0"
                                                Margin="2" ToolTip="Up-Right"/>

                                        <Button Grid.Row="1" Grid.Column="0"
                                                Content="←" FontSize="18"
                                                Click="BtnOffset_Click" Tag="W"
                                                Style="{StaticResource ModernButton}"
                                                Background="#374151" Padding="0"
                                                Margin="2" ToolTip="Left"/>
                                        <Border Grid.Row="1" Grid.Column="1"
                                                Background="#2D2D30" CornerRadius="6"
                                                Margin="2">
                                            <TextBlock Text="●" FontSize="14"
                                                       Foreground="#6B7280"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Row="1" Grid.Column="2"
                                                Content="→" FontSize="18"
                                                Click="BtnOffset_Click" Tag="E"
                                                Style="{StaticResource ModernButton}"
                                                Background="#374151" Padding="0"
                                                Margin="2" ToolTip="Right"/>

                                        <Button Grid.Row="2" Grid.Column="0"
                                                Content="↙" FontSize="18"
                                                Click="BtnOffset_Click" Tag="SW"
                                                Style="{StaticResource ModernButton}"
                                                Background="#374151" Padding="0"
                                                Margin="2" ToolTip="Down-Left"/>
                                        <Button Grid.Row="2" Grid.Column="1"
                                                Content="↓" FontSize="18"
                                                Click="BtnOffset_Click" Tag="S"
                                                Style="{StaticResource ModernButton}"
                                                Background="#374151" Padding="0"
                                                Margin="2" ToolTip="Down"/>
                                        <Button Grid.Row="2" Grid.Column="2"
                                                Content="↘" FontSize="18"
                                                Click="BtnOffset_Click" Tag="SE"
                                                Style="{StaticResource ModernButton}"
                                                Background="#374151" Padding="0"
                                                Margin="2" ToolTip="Down-Right"/>
                                    </Grid>

                                    <Border Height="1" Background="#3F3F46" Margin="0,0,0,15"/>

                                    <!-- Current Offset Display -->
                                    <TextBlock Text="ACCUMULATED OFFSET"
                                               Foreground="#3B82F6"
                                               FontSize="11" FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <Border Background="#2D2D30"
                                            BorderBrush="#3F3F46"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock x:Name="txtOffsetLabel1"
                                                           Text="Azimuth / RA:"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="txtOffsetAz"
                                                           Text="0.00&quot;"
                                                           Foreground="#10B981"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           FontFamily="Consolas"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock x:Name="txtOffsetLabel2"
                                                           Text="Altitude / Dec:"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="txtOffsetAlt"
                                                           Text="0.00&quot;"
                                                           Foreground="#10B981"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           FontFamily="Consolas"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Reset Button -->
                                    <Button x:Name="btnResetOffset"
                                            Click="BtnResetOffset_Click"
                                            Style="{StaticResource ModernButton}"
                                            Background="#EF4444"
                                            Height="34"
                                            Padding="10,0"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,15">
                                        <TextBlock Text="Reset Offset" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Collimation Analysis Control -->
                                    <local:CollimationAnalysisControl x:Name="collimationAnalysisControl"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: Pointing and Tracking -->
                        <TabItem Header="Pointing - Tracking">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,8,0,0">
                                <local:PointingAndTrackingControl x:Name="pointingAndTrackingControl"
                                                                   Margin="4,0"/>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
