<Window x:Class="ForkMount_WPF.UI.PointingGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Pointing Stability Graph"
        Height="720"
        Width="980"
        MinHeight="540"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2D2D30"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Valid Frames"
                               Foreground="#9CA3AF"
                               FontSize="11"/>
                    <TextBlock x:Name="txtValidFramesValue"
                               Text="--"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Positions"
                               Foreground="#9CA3AF"
                               FontSize="11"/>
                    <TextBlock x:Name="txtPositionsValue"
                               Text="--"
                               Foreground="#60A5FA"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Avg Jump"
                               Foreground="#9CA3AF"
                               FontSize="11"/>
                    <TextBlock x:Name="txtAvgJumpValue"
                               Text="--"
                               Foreground="#F472B6"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Total RMS"
                               Foreground="#9CA3AF"
                               FontSize="11"/>
                    <TextBlock x:Name="txtTotalRmsValue"
                               Text="--"
                               Foreground="#10B981"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   x:Name="txtGraphStatus"
                   Text="Run a pointing stability test to display frame offsets, jumps, and per-position RMS."
                   Foreground="#9CA3AF"
                   FontSize="12"
                   Margin="4,0,0,10"/>

        <Border Grid.Row="2"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8"
                Margin="0,0,0,10">
            <ScottPlot:WpfPlot x:Name="wpfFramePlot"/>
        </Border>

        <Border Grid.Row="3"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
            <ScottPlot:WpfPlot x:Name="wpfPositionPlot"/>
        </Border>
    </Grid>
</Window>
