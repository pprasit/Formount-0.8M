<UserControl x:Class="ForkMount_WPF.UI.CollimationAnalysisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#2D2D30"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,12">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="COLLIMATION ANALYSIS"
                       Foreground="#8B5CF6"
                       FontSize="11" FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <!-- Sample Count Input -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Samples:"
                           Foreground="#9CA3AF"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                
                <TextBox Grid.Column="1"
                         x:Name="txtSampleCount"
                         Text="5"
                         Background="#374151"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         BorderThickness="1"
                         Padding="6,4"
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         MaxLength="2"/>
                
                <TextBlock Grid.Column="2"
                           Text="images"
                           Foreground="#9CA3AF"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>

            <!-- Take Sample Images Button -->
            <Button x:Name="btnAnalyze"
                    Click="BtnAnalyze_Click"
                    Style="{StaticResource ModernButton}"
                    Background="#8B5CF6"
                    Height="34"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📸" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Take Sample Images" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Loading Indicator -->
            <StackPanel x:Name="loadingPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <ProgressBar x:Name="progressBar" 
                             Minimum="0" Maximum="100" Value="0"
                             Height="4" 
                             Foreground="#8B5CF6"
                             Margin="0,0,0,4"/>
                <TextBlock x:Name="txtProgress"
                           Text="Capturing image 1/5..."
                           Foreground="#9CA3AF"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Results Panel -->
            <Border x:Name="resultsPanel"
                    Background="#1E1E1E"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <!-- Quality Indicator -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="qualityIndicator"
                                 Width="12" Height="12"
                                 Fill="#6B7280"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="txtQuality"
                                   Text="Quality: Unknown"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Metrics Grid -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- FWHM -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="FWHM:"
                                   Foreground="#9CA3AF"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   x:Name="txtFWHM"
                                   Text="--"
                                   Foreground="#10B981"
                                   FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <!-- Roundness -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Roundness:"
                                   Foreground="#9CA3AF"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   x:Name="txtRoundness"
                                   Text="--"
                                   Foreground="#10B981"
                                   FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <!-- Stars Analyzed -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Stars:"
                                   Foreground="#9CA3AF"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   x:Name="txtStarsCount"
                                   Text="--"
                                   Foreground="#10B981"
                                   FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <!-- StdDev (NEW) -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="StdDev:"
                                   Foreground="#9CA3AF"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   x:Name="txtStdDev"
                                   Text="--"
                                   Foreground="#10B981"
                                   FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="#3F3F46" Margin="0,4,0,8"/>

                    <!-- Comparison with Previous (NEW) -->
                    <Border x:Name="comparisonPanel"
                            Background="#252525"
                            BorderBrush="#4B5563"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="COMPARISON"
                                       Foreground="#F59E0B"
                                       FontSize="9" FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtTrendIcon"
                                           Text="→"
                                           Foreground="#6B7280"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="txtComparison"
                                           Text="Same as previous"
                                           Foreground="#9CA3AF"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Detailed Message -->
                    <TextBlock x:Name="txtDetailedMessage"
                               Text="No analysis performed yet"
                               Foreground="#CCCCCC"
                               FontSize="10"
                               TextWrapping="Wrap"
                               LineHeight="14"/>
                </StackPanel>
            </Border>

            <!-- Info Text (when no results) -->
            <TextBlock x:Name="txtInfo"
                       Text="📸 Enter number of samples (5-10 recommended), then click 'Take Sample Images' to start."
                       Foreground="#6B7280"
                       FontSize="10"
                       TextWrapping="Wrap"
                       LineHeight="14"
                       Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
