<UserControl x:Class="ForkMount_WPF.UI.InstrumentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>

        <!-- Implicit Button Style: round corners -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <!-- Panel 1: Field-Derotator -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <!-- Panel 2: Focuser -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════ PANEL 1 — FIELD-DEROTATOR (Axis 3) ══════════════════════ -->
        <StackPanel Grid.Column="0">

            <!-- Status Card -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="FIELD-DEROTATOR STATUS"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- PA Angle -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PA Angle"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <TextBlock x:Name="txtInstCurrentPosition"
                                       Text="---"
                                       Foreground="{StaticResource SuccessGreen}"
                                       FontSize="20" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="deg"
                                       Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                        </StackPanel>

                        <!-- Rotation Rate -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Rotation Rate"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <TextBlock x:Name="txtInstCurrentVelocity"
                                       Text="---"
                                       Foreground="{StaticResource PrimaryAccent}"
                                       FontSize="20" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="deg/s"
                                       Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                        </StackPanel>

                        <!-- Motor Status -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Motor Status"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="instMotorIndicator"
                                         Width="10" Height="10"
                                         Fill="{StaticResource ErrorRed}"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtInstMotorStatus"
                                           Text="Disabled"
                                           Foreground="{StaticResource ErrorRed}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Field-Derotation Rate Display -->
                    <Border Background="#0F1419" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Az (mount)"
                                           Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                <TextBlock x:Name="txtDerotAz"
                                           Text="---" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Alt (mount)"
                                           Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                <TextBlock x:Name="txtDerotAlt"
                                           Text="---" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Computed Rate"
                                           Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                <TextBlock x:Name="txtDerotComputedRate"
                                           Text="---" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource WarningOrange}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Velocity Control Card -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="MANUAL JOG"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,14"/>
                    <TextBlock Text="Jog Speed (deg/s)"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtInstJogSpeed"
                             Style="{StaticResource ModernTextBox}"
                             Text="1.0" Margin="0,0,0,14"
                             LostFocus="TxtInstJogSpeed_LostFocus"
                             KeyDown="TxtInst_KeyDown"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="◄ Jog" Height="36"
                                Background="#3B82F6" Foreground="White" FontSize="12"
                                PreviewMouseLeftButtonDown="BtnInstJogMinus_MouseDown"
                                PreviewMouseLeftButtonUp="BtnInstJogMinus_MouseUp"/>
                        <Button Grid.Column="2" Content="■ Stop" Height="36"
                                Background="#EF4444" Foreground="White" FontSize="12"
                                Click="BtnInstJogStop_Click"/>
                        <Button x:Name="btnInstMoveContinuous"
                                Grid.Column="4" Content="Move Continuous" Height="36"
                                Background="#8B5CF6" Foreground="White" FontSize="11"
                                FontWeight="SemiBold"
                                Click="BtnInstMoveContinuous_Click"/>
                        <Button Grid.Column="6" Content="Jog ►" Height="36"
                                Background="#3B82F6" Foreground="White" FontSize="12"
                                PreviewMouseLeftButtonDown="BtnInstJogPlus_MouseDown"
                                PreviewMouseLeftButtonUp="BtnInstJogPlus_MouseUp"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Position Control Card -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="POSITION CONTROL"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,14"/>
                    <TextBlock Text="Target PA (deg)"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtInstTargetPosition"
                             Style="{StaticResource ModernTextBox}"
                             Text="0.00" Margin="0,0,0,12"
                             LostFocus="TxtInstTargetPosition_LostFocus"
                             KeyDown="TxtInst_KeyDown"/>
                    <TextBlock Text="Velocity (deg/s)"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtInstGotoVelocity"
                             Style="{StaticResource ModernTextBox}"
                             Text="1.0" Margin="0,0,0,14"
                             LostFocus="TxtInstGotoVelocity_LostFocus"
                             KeyDown="TxtInst_KeyDown"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Goto PA" Height="36"
                                Background="#3B82F6" Foreground="White" FontSize="12"
                                Click="BtnInstGoto_Click"/>
                        <Button Grid.Column="2" Content="Stop" Height="36"
                                Background="#EF4444" Foreground="White" FontSize="12"
                                Click="BtnInstStop_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Motor + Field-Derotation Control Card -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="MOTOR &amp; DEROTATION CONTROL"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Enable / Disable -->
                        <Button x:Name="btnInstEnable"
                                Grid.Column="0"
                                Content="Enable"
                                Height="36"
                                Background="{StaticResource SuccessGreen}"
                                Foreground="White" FontSize="12"
                                Click="BtnInstEnable_Click"/>
                        <!-- Field-Derotation Toggle -->
                        <Button x:Name="btnFieldDerotation"
                                Grid.Column="2"
                                Content="Field-Derot: OFF"
                                Height="36"
                                Background="#4B5563"
                                Foreground="White" FontSize="11"
                                Click="BtnFieldDerotation_Click"/>
                    </Grid>
                    <Button x:Name="btnDerotationDirection"
                            Content="Direction: Normal"
                            Height="32"
                            Margin="0,0,0,10"
                            Background="#1F2937"
                            Foreground="White" FontSize="11"
                            Click="BtnDerotationDirection_Click"/>
                    <TextBlock x:Name="txtInstStatus"
                               Text="Ready"
                               Foreground="{StaticResource SuccessGreen}"
                               FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ══════════════════════ PANEL 2 — FOCUSER ══════════════════════ -->
        <StackPanel Grid.Column="2">

            <!-- Focuser Header -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="FOCUSER"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Focus control will be configured here."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="Axis assignment and encoder resolution to be defined."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Field-Derotator Info Card -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="FIELD-DEROTATOR INFO"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Encoder Resolution : 32-bit  (4,294,967,296 counts/rev)"
                               Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="Axis Number : 3  (FORK1)"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock Text="Velocity Command : JP + BG  (continuous jog)"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock Text="Position Command : MO=1 → SP → PA → BG"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock Text="Observer Lat : 18.5736°N  (NARIT)"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock Text="Derotation Rate : ω·cos(φ)·cos(Az) / cos(Alt)"
                               Foreground="{StaticResource WarningOrange}" FontSize="11"
                               FontFamily="Consolas" Margin="0,8,0,0"/>
                    <TextBlock Text="Direction Toggle : multiplies commanded rate by -1 for hardware sign matching"
                               Foreground="{StaticResource TextSecondary}" FontSize="10"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Last Command Card -->
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="LAST COMMAND"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtInstLastCommand"
                               Text="—"
                               Foreground="{StaticResource PrimaryAccent}"
                               FontSize="11" FontFamily="Consolas"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </Grid>
</UserControl>
