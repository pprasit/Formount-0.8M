<UserControl x:Class="ForkMount_WPF.UI.CalibrationSkyMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="420">

    <UserControl.Resources>
        <SolidColorBrush x:Key="MapBackground" Color="#171921"/>
        <SolidColorBrush x:Key="GridLine" Color="#4B5563"/>
        <SolidColorBrush x:Key="PendingPoint" Color="#6B7280"/>
        <SolidColorBrush x:Key="MeasuredPoint" Color="#10B981"/>
        <SolidColorBrush x:Key="CurrentPoint" Color="#3B82F6"/>
        <SolidColorBrush x:Key="ErrorPoint" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextColor" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="LabelColor" Color="#9CA3AF"/>
    </UserControl.Resources>

    <Border Background="{StaticResource MapBackground}"
            CornerRadius="10"
            BorderBrush="#2D3748"
            BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.3" ShadowDepth="2" BlurRadius="10"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Calibration Sky Map"
                       Foreground="{StaticResource TextColor}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- Sky Map Canvas -->
            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="50">
                <Canvas x:Name="skyCanvas"
                        Width="360"
                        Height="360"
                        Background="Transparent"
                        ClipToBounds="False">
                    
                    <!-- Outer Circle (Horizon) -->
                    <Ellipse Width="340" Height="340"
                             Stroke="{StaticResource GridLine}"
                             StrokeThickness="2"
                             Canvas.Left="10"
                             Canvas.Top="10"/>

                    <!-- 30 deg Elevation Circle -->
                    <Ellipse Width="227" Height="227"
                             Stroke="{StaticResource GridLine}"
                             StrokeThickness="1.5"
                             StrokeDashArray="4,2"
                             Canvas.Left="66.5"
                             Canvas.Top="66.5"/>

                    <!-- 60 deg Elevation Circle -->
                    <Ellipse Width="113" Height="113"
                             Stroke="{StaticResource GridLine}"
                             StrokeThickness="1.5"
                             StrokeDashArray="4,2"
                             Canvas.Left="123.5"
                             Canvas.Top="123.5"/>

                    <!-- Zenith (90 deg) -->
                    <Ellipse Width="6" Height="6"
                             Fill="{StaticResource GridLine}"
                             Canvas.Left="177"
                             Canvas.Top="177"/>

                    <!-- Crosshairs -->
                    <Line X1="180" Y1="10" X2="180" Y2="350"
                          Stroke="{StaticResource GridLine}"
                          StrokeThickness="1"
                          StrokeDashArray="2,2"/>
                    <Line X1="10" Y1="180" X2="350" Y2="180"
                          Stroke="{StaticResource GridLine}"
                          StrokeThickness="1"
                          StrokeDashArray="2,2"/>

                    <!-- Azimuth Labels -->
                    <TextBlock Text="N (0 deg)"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="12"
                               FontWeight="Bold"
                               Canvas.Left="158"
                               Canvas.Top="-12"/>
                    
                    <!-- E label - moved outside circle -->
                    <TextBlock Text="E (90 deg)"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="12"
                               FontWeight="Bold"
                               Canvas.Left="340"
                               Canvas.Top="172">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="20" Y="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    
                    <TextBlock Text="S (180 deg)"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="12"
                               FontWeight="Bold"
                               Canvas.Left="150"
                               Canvas.Top="354"/>
                    
                    <!-- W label - moved outside circle -->
                    <TextBlock Text="W (270 deg)"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="12"
                               FontWeight="Bold"
                               Canvas.Left="-30"
                               Canvas.Top="172">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="-35" Y="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <!-- Elevation Labels -->
                    <TextBlock Text="30 deg"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="10"
                               Canvas.Left="242"
                               Canvas.Top="106"/>
                    <TextBlock Text="60 deg"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="10"
                               Canvas.Left="203"
                               Canvas.Top="146"/>

                    <!-- Pointing Model Points Container -->
                    <!-- DISABLED: pointsCanvas blocks marker visibility -->
                    
                    <!-- Mount Position Marker (dynamic) -->
                    <!-- Position will be set by code-behind using Canvas.SetLeft/SetTop -->
                    <Ellipse x:Name="mountMarker"
                             Width="17"
                             Height="17"
                             Fill="Transparent"
                             Stroke="White"
                             StrokeThickness="2.5"
                             Visibility="Visible"
                             Canvas.ZIndex="9999">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00D9FF"
                                            Opacity="0.9"
                                            ShadowDepth="0"
                                            BlurRadius="18"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Viewbox>

            <!-- Legend -->
            <Border Grid.Row="2"
                    Background="#1A1F2E"
                    BorderBrush="#2D3748"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pending -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource PendingPoint}"
                                 Stroke="#4B5563"
                                 StrokeThickness="1"
                                 VerticalAlignment="Center"
                                 Margin="0,0,5,0"/>
                        <TextBlock Text="Pending"
                                   Foreground="{StaticResource LabelColor}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Measured -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource MeasuredPoint}"
                                 Stroke="White"
                                 StrokeThickness="1"
                                 VerticalAlignment="Center"
                                 Margin="0,0,5,0"/>
                        <TextBlock Text="Measured"
                                   Foreground="{StaticResource LabelColor}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Current -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                        <Ellipse Width="10" Height="10"
                                 Fill="{StaticResource CurrentPoint}"
                                 Stroke="White"
                                 StrokeThickness="1.5"
                                 VerticalAlignment="Center"
                                 Margin="0,0,5,0"/>
                        <TextBlock Text="Current"
                                   Foreground="{StaticResource LabelColor}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stats -->
                    <TextBlock Grid.Column="3"
                               x:Name="txtStats"
                               Text="0/0 points"
                               Foreground="{StaticResource LabelColor}"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
