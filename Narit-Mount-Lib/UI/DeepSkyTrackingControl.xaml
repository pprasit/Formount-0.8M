<UserControl x:Class="ForkMount_WPF.UI.DeepSkyTrackingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="DarkBackground" Color="#0F1419"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1A1F2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D3748"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="PurpleAccent" Color="#8B5CF6"/>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="#1F2937"/>
            <Setter Property="AlternatingRowBackground" Value="#252D3D"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="RowHeight" Value="35"/>
        </Style>

        <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252D3D"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PurpleAccent}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row Style for Current Target Highlighting -->
        <Style x:Key="TrackingRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentTarget}" Value="True">
                    <Setter Property="Background" Value="#7C3AED"/>
                    <Setter Property="BorderBrush" Value="#A78BFA"/>
                    <Setter Property="BorderThickness" Value="2,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        HorizontalScrollBarVisibility="Auto" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Target Coordinates Input -->
        <Border Grid.Row="0"
                Background="#1F2937"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Target Coordinates"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <!-- RA Input -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="RA (J2000):" 
                               Foreground="{StaticResource TextSecondary}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"
                               FontSize="12"/>
                    <TextBox x:Name="txtRA" 
                             Text="00:00:00.0" 
                             Width="150" 
                             Height="32"
                             Style="{StaticResource RoundedTextBox}"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextAlignment="Center"
                             TextChanged="TxtCoordinate_TextChanged"
                             ToolTip="Supported formats: 6.752481 or 06:45:08.9 or 06 45 08.9"/>
                </StackPanel>

                <!-- Dec Input -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="Dec (J2000):" 
                               Foreground="{StaticResource TextSecondary}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"
                               FontSize="12"/>
                    <TextBox x:Name="txtDec" 
                             Text="+00:00:00.0" 
                             Width="150" 
                             Height="32"
                             Style="{StaticResource RoundedTextBox}"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextAlignment="Center"
                             TextChanged="TxtCoordinate_TextChanged"
                             ToolTip="Supported formats: -16.716116 or +19:10:56.7 or -52 41 44.4"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <!-- Track Button -->
                    <Button x:Name="btnStartTrack" 
                            Click="BtnStartTrack_Click"
                            Content="Track"
                            Height="32"
                            Width="90"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#059669"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#374151"/>
                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Stop Button -->
                    <Button x:Name="btnStopTrack" 
                            Click="BtnStopTrack_Click"
                            Content="Stop"
                            Height="32"
                            Width="90"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            IsEnabled="False">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource ErrorRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#374151"/>
                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="1"
                Background="#1F2937"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Label -->
                <TextBlock Grid.Column="0" Text="Filter:" 
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="0,0,12,0"/>

                <!-- Category Filter -->
                <ComboBox x:Name="cboCategory" 
                          Grid.Column="1"
                          Style="{DynamicResource ModernComboBox}"
                          Width="140"
                          Height="32"
                          Margin="0,0,12,0"
                          SelectionChanged="CboCategory_SelectionChanged">
                    <ComboBoxItem Content="All Objects" IsSelected="True"/>
                    <ComboBoxItem Content="Messier Only"/>
                    <ComboBoxItem Content="Galaxies"/>
                    <ComboBoxItem Content="Open Clusters"/>
                    <ComboBoxItem Content="Globular Clusters"/>
                    <ComboBoxItem Content="Nebulae"/>
                    <ComboBoxItem Content="Planetary Nebulae"/>
                </ComboBox>

                <!-- Constellation Filter -->
                <ComboBox x:Name="cboConstellation" 
                          Grid.Column="2"
                          Style="{DynamicResource ModernComboBox}"
                          Width="100"
                          Height="32"
                          Margin="0,0,12,0"
                          SelectionChanged="CboConstellation_SelectionChanged">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                </ComboBox>

                <!-- Visible Only Checkbox -->
                <CheckBox x:Name="chkVisibleOnly" 
                          Grid.Column="4"
                          Content="Visible Only"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Margin="0,0,16,0"
                          IsChecked="False"
                          Checked="ChkVisibleOnly_Changed"
                          Unchecked="ChkVisibleOnly_Changed"/>

                <CheckBox x:Name="chkTrackingOn"
                          Grid.Column="5"
                          Content="Tracking On"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"
                          FontSize="11"
                          IsChecked="False"
                          Checked="ChkTrackingOn_Changed"
                          Unchecked="ChkTrackingOn_Changed"/>
            </Grid>
        </Border>

        <!-- NGC Object Catalog -->
        <Border Grid.Row="2"
                Background="#1F2937"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="NGC/IC Deep Sky Catalog"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="16,12,16,12"/>

                <DataGrid x:Name="dgDeepSkyObjects"
                          Grid.Row="1"
                          Style="{StaticResource ModernDataGrid}"
                          RowStyle="{StaticResource TrackingRowStyle}"
                          ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                          CellStyle="{StaticResource CellStyle}"
                          SelectionChanged="DgDeepSkyObjects_SelectionChanged"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="90" SortMemberPath="Name"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeDescription}" Width="120" SortMemberPath="Type"/>
                        <DataGridTextColumn Header="Const" Binding="{Binding Constellation}" Width="60" SortMemberPath="Constellation"/>
                        <DataGridTextColumn Header="RA (J2000)" Binding="{Binding RAFormatted}" Width="120" SortMemberPath="RightAscension"/>
                        <DataGridTextColumn Header="Dec (J2000)" Binding="{Binding DecFormatted}" Width="120" SortMemberPath="Declination"/>
                        <DataGridTextColumn Header="Mag" Binding="{Binding Magnitude, StringFormat=F1}" Width="60" SortMemberPath="Magnitude"/>
                        <DataGridTextColumn Header="Azimuth (deg)" Binding="{Binding Azimuth, StringFormat=F2}" Width="90" SortMemberPath="Azimuth"/>
                        <DataGridTextColumn Header="Altitude (deg)" Binding="{Binding Altitude, StringFormat=F2}" Width="*" SortMemberPath="Altitude"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="#1F2937"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Auto Track Button -->
                <Button Grid.Column="0" 
                        x:Name="btnAutoTrack"
                        Click="BtnAutoTrack_Click"
                        Content="Auto Track"
                        Background="#6366f1"
                        Foreground="White"
                        BorderThickness="0"
                        Height="28"
                        Width="100"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,12,0"
                        ToolTip="Automatically cycle through visible objects">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                Padding="12,0">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4f46e5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Advanced Tuning Button -->
                <Button Grid.Column="1" 
                        x:Name="btnAdvancedTuning"
                        Click="BtnAdvancedTuning_Click"
                        Content="Advanced Tuning"
                        Background="#6366f1"
                        Foreground="White"
                        BorderThickness="0"
                        Height="28"
                        Width="120"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        ToolTip="Open PD Controller Tuning Window">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                Padding="12,0">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4f46e5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Status Text -->
                <TextBlock x:Name="txtStatus" 
                           Grid.Column="2"
                           Text="" 
                           Foreground="{StaticResource TextSecondary}" 
                           FontSize="11" 
                           VerticalAlignment="Center" 
                           Margin="12,0"/>

                <!-- Object Count -->
                <TextBlock x:Name="txtObjectCount" 
                           Grid.Column="3"
                           Text="Objects: 0 | Visible: 0" 
                           Foreground="{StaticResource TextSecondary}" 
                           FontSize="11" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
