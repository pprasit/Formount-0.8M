<UserControl x:Class="ForkMount_WPF.UI.AutoSaveFitsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PrefixTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#2D2D30"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,8">
        <StackPanel>
            <!-- Header: Title + Count + Enable -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="AUTO SAVE FITS"
                           Foreground="#3B82F6"
                           FontSize="10" FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="txtSaveCount"
                               Text="0 saved"
                               Foreground="#6B7280"
                               FontSize="9"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <CheckBox x:Name="chkAutoSave"
                              Content="Enable"
                              Foreground="#CCCCCC"
                              FontSize="10"
                              VerticalContentAlignment="Center"
                              Checked="ChkAutoSave_Changed"
                              Unchecked="ChkAutoSave_Changed"/>
                </StackPanel>
            </Grid>

            <!-- Total Frames -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Frames"
                           Foreground="#CCCCCC"
                           FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         x:Name="txtTotalFrames"
                         Text="0"
                         Style="{StaticResource PrefixTextBox}"
                         ToolTip="Total frames to capture (0 = unlimited)"/>
            </Grid>

            <!-- Filename Composition -->
            <TextBlock Text="FILENAME PARTS"
                       Foreground="#F59E0B"
                       FontSize="9" FontWeight="Bold"
                       Margin="0,2,0,4"/>

            <!-- 1: Frame Type -->
            <Grid Margin="0,0,0,3" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkFrameType"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         x:Name="txtFrameType"
                         Text="Light"
                         Style="{StaticResource PrefixTextBox}"
                         ToolTip="Frame type (Light, Dark, Flat, Bias)"/>
            </Grid>

            <!-- 2: Object Name -->
            <Grid Margin="0,0,0,3" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkObjectName"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         x:Name="txtObjectName"
                         Text=""
                         Style="{StaticResource PrefixTextBox}"
                         ToolTip="Object name (auto-filled from tracking target)"/>
            </Grid>

            <!-- 3: Date Stamp -->
            <Grid Margin="0,0,0,3" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkDateStamp"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         x:Name="txtDateStamp"
                         IsReadOnly="True"
                         Style="{StaticResource PrefixTextBox}"
                         ToolTip="Date stamp (auto-generated DDMMMyyyy)"
                         Foreground="#9CA3AF"/>
            </Grid>

            <!-- 4: Incremental Number -->
            <Grid Margin="0,0,0,5" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkSequenceNum"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         x:Name="txtSequenceNum"
                         IsReadOnly="True"
                         Style="{StaticResource PrefixTextBox}"
                         ToolTip="Incremental frame number (auto)"
                         Foreground="#9CA3AF"/>
            </Grid>

            <!-- Preview -->
            <TextBlock x:Name="txtFilenamePreview"
                       Text=""
                       Foreground="#6EE7B7"
                       FontSize="9"
                       FontFamily="Consolas"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,5"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

            <!-- Save Directory + Save / Browse buttons -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtSaveDir"
                           Text="(not set)"
                           Foreground="#9CA3AF"
                           FontSize="9"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <!-- Manual Save button -->
                <Button Grid.Column="1"
                        x:Name="btnManualSave"
                        Click="BtnManualSave_Click"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="8,2"
                        FontSize="9"
                        Cursor="Hand"
                        Margin="6,0,0,0"
                        ToolTip="Save current image as FITS">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#4B5563"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Save" FontSize="9" FontWeight="SemiBold"/>
                </Button>
                <!-- Browse button -->
                <Button Grid.Column="2"
                        x:Name="btnBrowse"
                        Click="BtnBrowse_Click"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="8,2"
                        FontSize="9"
                        Cursor="Hand"
                        Margin="4,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4B5563"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Browse" FontSize="9"/>
                </Button>
            </Grid>

            <!-- Last saved status -->
            <TextBlock x:Name="txtLastSaved"
                       Text=""
                       Foreground="#6EE7B7"
                       FontSize="9"/>
        </StackPanel>
    </Border>
</UserControl>
