<Window x:Class="ForkMount_WPF.UI.CameraSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ZWO Camera Settings"
    Width="900" Height="900"
    WindowStartupLocation="CenterOwner"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStyle="None"
    AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                 ResizeBorderThickness="5"
                 GlassFrameThickness="0"
                 CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#252526"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="Foreground" Value="#4B5563"/>
                    <Setter Property="BorderBrush" Value="#2D3748"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                        Grid.Column="2"
                                        Focusable="false"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                            IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="10,0,30,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#374151"
                                            BorderBrush="#4B5563"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="Foreground" Value="#4B5563"/>
                    <Setter Property="BorderBrush" Value="#2D3748"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider disabled style -->
        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox disabled style -->
        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Title Bar Button Styles -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Container with Border -->
    <Border Background="#1E1E1E"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Window Icon & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0">
                        <Path Data="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"
                              Fill="#3B82F6"
                              Stretch="Uniform"
                              Width="20"
                              Height="20"
                              Margin="0,0,12,0"/>
                        <TextBlock Text="Camera Control"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btnMinimize"
                               Content="―"
                               Click="BtnMinimize_Click"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="btnMaximize"
                               Content="☐"
                               Click="BtnMaximize_Click"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="btnClose"
                               Content="✕"
                               Click="BtnClose_Click"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Style="{StaticResource TitleBarCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="15,0,15,0" Margin="0,0,0,15">
                    <Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Camera Configuration "
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="18" FontWeight="Bold"/>
                            <!-- Status Indicator (Ellipse for reliable rendering) -->
                            <Ellipse x:Name="statusIndicator"
                             Width="10" Height="10"
                             Fill="#EF4444"
                             VerticalAlignment="Center"
                             Margin="4,4,8,0"/>
                            <TextBlock x:Name="txtCameraName"
                              Text="Not Connected"
                              Foreground="#EF4444"
                              VerticalAlignment="Center"
                              Margin="0,4,8,0"
                              FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Settings Section -->
                <Border Grid.Row="1" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <Grid x:Name="gridSettings">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Camera Selector -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                          Text="Camera:"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                             x:Name="cmbCameraDevice"
                             Style="{StaticResource ModernComboBox}"
                             Height="30"
                             HorizontalAlignment="Stretch"
                             SelectionChanged="CmbCameraDevice_SelectionChanged"/>

                        <!-- Cooler -->
                        <TextBlock Grid.Row="0" Grid.Column="3"
                          Text="Cooler:"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="0,0,15,0"/>
                        <Grid Grid.Row="0" Grid.Column="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="chkCoolerOn"
                                     Style="{StaticResource SettingsCheckBox}"
                                     Content="" VerticalAlignment="Center"
                                     Foreground="{StaticResource TextSecondary}"
                                     Checked="ChkCooler_Changed" Unchecked="ChkCooler_Changed"/>
                            <TextBox Grid.Column="1"
                                    x:Name="txtCoolerTemp"
                                    Style="{StaticResource ModernTextBox}"
                                    Text="-10" Margin="5,0,5,0"/>
                            <TextBlock Grid.Column="2"
                                      Text="°C"
                                      Foreground="{StaticResource TextSecondary}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Exposure Time -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                          Text="Exposure:"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                        x:Name="txtExposureTime"
                        Style="{StaticResource ModernTextBox}"
                        Text="1000"                        
                        HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                          Text="ms"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <!-- Gain (ZWO only) -->
                        <TextBlock Grid.Row="2" Grid.Column="3"
                          x:Name="lblGain"
                          Text="Gain:"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="0,0,15,0"/>
                        <Grid Grid.Row="2" Grid.Column="4" x:Name="panelGain">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="sliderGain"
                           Style="{StaticResource SettingsSlider}"
                           Minimum="0" Maximum="600" Value="0"
                           VerticalAlignment="Center"
                           ValueChanged="SliderGain_ValueChanged"/>
                            <TextBox Grid.Column="1"
                            x:Name="txtGain"
                            Style="{StaticResource ModernTextBox}"
                            Text="0" Margin="10,0,0,0"
                            TextChanged="TxtGain_TextChanged"/>
                        </Grid>

                        <!-- Offset (ZWO only) -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                          x:Name="lblOffset"
                          Text="Offset:"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"/>
                        <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" x:Name="panelOffset">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="sliderOffset"
                           Style="{StaticResource SettingsSlider}"
                           Minimum="0" Maximum="100" Value="0"
                           VerticalAlignment="Center"
                           ValueChanged="SliderOffset_ValueChanged"/>
                            <TextBox Grid.Column="1"
                            x:Name="txtOffset"
                            Style="{StaticResource ModernTextBox}"
                            Text="0" Margin="10,0,0,0"
                            TextChanged="TxtOffset_TextChanged"/>
                        </Grid>

                        <!-- Binning -->
                        <TextBlock Grid.Row="6" Grid.Column="0"
                          Text="Binning:"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="6" Grid.Column="1"
                         x:Name="cmbBinning"
                         Style="{StaticResource ModernComboBox}"
                         Height="30"
                         HorizontalAlignment="Stretch"
                         SelectionChanged="CmbBinning_SelectionChanged">
                            <ComboBoxItem Content="1x1 (Full Resolution)" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="2x2 (Half Resolution)" Tag="2"/>
                            <ComboBoxItem Content="3x3" Tag="3"/>
                            <ComboBoxItem Content="4x4" Tag="4"/>
                        </ComboBox>

                        <!-- Image Type (ZWO only) -->
                        <TextBlock Grid.Row="6" Grid.Column="3"
                          x:Name="lblImageType"
                          Text="Image Type:"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="0,0,15,0"/>
                        <ComboBox Grid.Row="6" Grid.Column="4"
                         x:Name="cmbImageType"
                         Style="{StaticResource ModernComboBox}"
                         Height="30"
                         SelectionChanged="CmbImageType_SelectionChanged">
                            <ComboBoxItem Content="RAW8 (8-bit)" Tag="0"/>
                            <ComboBoxItem Content="RGB24 (Color, no binning)" Tag="1"/>
                            <ComboBoxItem Content="RAW16 (16-bit) ⭐" Tag="2" IsSelected="True"/>
                        </ComboBox>

                        <!-- Focal Length -->
                        <TextBlock Grid.Row="8" Grid.Column="0"
                          Text="Focal Length:"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center"
                          ToolTip="Focal length of telescope/lens in millimeters (for PlateScale calculation)"/>
                        <TextBox Grid.Row="8" Grid.Column="1"
                        x:Name="txtFocalLength"
                        Style="{StaticResource ModernTextBox}"
                        Text="200"
                        HorizontalAlignment="Stretch"
                        TextChanged="TxtFocalLength_TextChanged"
                        ToolTip="Enter focal length in millimeters (e.g., 200, 500, 1000)"/>
                        <TextBlock Grid.Row="8" Grid.Column="2"
                          Text="mm"
                          Foreground="{StaticResource TextSecondary}"
                          VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <!-- Field of View Info (Auto-calculated) -->
                        <TextBlock Grid.Row="8" Grid.Column="3" Grid.ColumnSpan="2"
                          x:Name="txtFOVInfo"
                          Text="FOV: Calculating..."
                          Foreground="#10B981"
                          FontSize="11"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="15,0,0,0"
                          ToolTip="Field of View (calculated from resolution, binning, focal length, and pixel size)"/>
                    </Grid>
                </Border>


                <!-- Preview Area -->
                <Border Grid.Row="2" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <TextBlock Text="Camera Preview"
                          Foreground="{StaticResource TextPrimary}"
                          FontSize="14" FontWeight="SemiBold"
                          Margin="10,5"/>

                            <!-- Row 1: Profile Selection -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,8">
                                <TextBlock Text="Profile:" Foreground="#9CA3AF" FontSize="11" 
                              VerticalAlignment="Center" Margin="0,1,10,0"/>
                                <ComboBox x:Name="cmbStretchProfile"
                             Style="{StaticResource ModernComboBox}"
                             Width="160" Height="28" Margin="0,1,0,0"
                             SelectionChanged="CmbStretchProfile_SelectionChanged"
                             ToolTip="Select histogram stretch preset">
                                    <ComboBoxItem Content="Auto" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="Low (Bright)" Tag="1"/>
                                    <ComboBoxItem Content="Medium" Tag="2"/>
                                    <ComboBoxItem Content="High (Faint)" Tag="3"/>
                                    <ComboBoxItem Content="Manual" Tag="4"/>
                                    <ComboBoxItem Content="Bright Stars" Tag="5"/>
                                    <ComboBoxItem Content="Moon" Tag="6"/>
                                    <ComboBoxItem Content="Planet" Tag="7"/>
                                    <ComboBoxItem Content="Deep Sky" Tag="8"/>
                                </ComboBox>

                                <TextBlock x:Name="txtProfileInfo" Text="" 
              Foreground="#6EE7B7" FontSize="10" 
              VerticalAlignment="Center" Margin="15,0,0,0"
              ToolTip="Current percentile settings for selected profile"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Zoom Info & View Control Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
                            <TextBlock x:Name="txtImageInfo" x:FieldModifier="private"
                              Text=""
                              Foreground="{StaticResource TextSecondary}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="0,0,15,0"/>
                            <TextBlock x:Name="txtZoomInfo" x:FieldModifier="private"
                              Text="Zoom: 100%"
                              Foreground="{StaticResource TextSecondary}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>

                            <!-- 1:1 (100%) Button - Modern Style -->
                            <Button x:Name="btn1to1"
                            Click="BtnReset1to1_Click"
                            Style="{StaticResource ModernButton}"
                            Background="#6B7280"
                            Height="28"
                            Padding="12,0"
                            Margin="0,0,5,0"
                            ToolTip="Show image at actual size (1:1 scale)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="1:1" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Fit to Window Button - Modern Style -->
                            <Button x:Name="btnFitWindow"
                            Click="BtnResetZoom_Click"
                            Style="{StaticResource ModernButton}"
                            Background="#4B5563"
                            Height="28"
                            Padding="12,0"
                            ToolTip="Fit image to window size">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fit" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Histogram Stretch Controls -->
                        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" 
                       CornerRadius="6" Padding="10,8" Margin="0,37,0,10"
                       HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 2: Min/Max Sliders -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="Black:" Foreground="{StaticResource TextSecondary}" FontSize="11" 
                                      VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Slider x:Name="sliderHistogramMin"
                                   Minimum="0" Maximum="65535" Value="0"
                                   Width="140"
                                   VerticalAlignment="Center"
                                   ValueChanged="SliderHistogram_ValueChanged"
                                   ToolTip="Minimum brightness level (black point)"/>
                                    <TextBlock x:Name="txtHistogramMin" Text="0" 
                                      Foreground="White" FontSize="11" FontFamily="Consolas"
                                      VerticalAlignment="Center" Margin="5,0,15,0" MinWidth="50"/>

                                    <TextBlock Text="White:" Foreground="{StaticResource TextSecondary}" FontSize="11" 
                                      VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Slider x:Name="sliderHistogramMax"
                                   Minimum="0" Maximum="65535" Value="65535"
                                   Width="140"
                                   VerticalAlignment="Center"
                                   ValueChanged="SliderHistogram_ValueChanged"
                                   ToolTip="Maximum brightness level (white point)"/>
                                    <TextBlock x:Name="txtHistogramMax" Text="65535" 
                                      Foreground="White" FontSize="11" FontFamily="Consolas"
                                      VerticalAlignment="Center" Margin="5,0,10,0" MinWidth="50"/>

                                    <Button x:Name="btnAutoStretch"
                                   Click="BtnAutoStretch_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="#10B981"
                                   Height="26"
                                   Padding="10,0"
                                   ToolTip="Apply stretch using current profile's percentiles">
                                        <TextBlock Text="Apply" FontSize="10" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="btnSwitchToLastestImage"
                                        Click="BtnSwitchToLastestImage_Click"
                                        Style="{StaticResource ModernButton}"
                                        Background="#FF1E7CE6"
                                        Height="26"
                                        Padding="10,0"
                                        Margin="7,0,0,0"
                                        ToolTip="Switch to Last Image">
                                        <TextBlock Text="Switch to Last Image" FontSize="10" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" x:Name="borderPreview" x:FieldModifier="private"
                       BorderBrush="#3F3F46" BorderThickness="1"
                       CornerRadius="6" Background="#1A1A1A"
                       ClipToBounds="True"
                       SizeChanged="BorderPreview_SizeChanged">
                            <Grid>
                                <!-- ScrollViewer for zoom/pan navigation -->
                                <ScrollViewer x:Name="scrollViewer" x:FieldModifier="private"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent">
                                    <!-- Image with explicit size (set in code-behind) -->
                                    <Image x:Name="imgPreview"
                                  Stretch="None"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  MouseWheel="ImgPreview_MouseWheel"
                                  MouseLeftButtonDown="ImgPreview_MouseLeftButtonDown"
                                  MouseLeftButtonUp="ImgPreview_MouseLeftButtonUp"
                                  MouseMove="ImgPreview_MouseMove"
                                  MouseLeave="ImgPreview_MouseLeave"
                                  Cursor="Hand"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Loading Indicator with Countdown -->
                        <Grid Grid.Row="1" x:Name="loadingPanel" Visibility="Collapsed"
                     Background="#AA000000">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Capturing..."
                                  Foreground="White"
                                  FontSize="16" FontWeight="Bold"
                                  HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtCountdown"
                                  Text="0.000 s"
                                  Foreground="#10B981"
                                  FontSize="24" FontWeight="Bold"
                                  FontFamily="Consolas"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                                <ProgressBar IsIndeterminate="True"
                                    Width="200" Height="4"
                                    Margin="0,10,0,0"
                                    Foreground="#3B82F6"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                   x:Name="btnTestCapture"
                   Content="Test Capture"
                   Click="BtnTestCapture_Click"
                   Style="{StaticResource ModernButton}"
                   Height="40"
                   Background="#10B981"/>

                    <Button Grid.Column="2"
                   x:Name="btnApply"
                   Content="Apply Settings"
                   Click="BtnApply_Click"
                   Style="{StaticResource ModernButton}"
                   Height="40"/>

                    <Button Grid.Column="4"
                   x:Name="btnCloseWindow"
                   Content="Close"
                   Click="BtnClose_Click"
                   Style="{StaticResource ModernButton}"
                   Height="40"
                   Background="#6B7280"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
