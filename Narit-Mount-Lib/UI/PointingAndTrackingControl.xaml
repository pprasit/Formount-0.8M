<UserControl x:Class="ForkMount_WPF.UI.PointingAndTrackingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#4B5563"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- SEEING + TRACKING SECTION -->
        <Border Background="#2D2D30"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SEEING + TRACKING ANALYSIS"
                           Foreground="#14B8A6"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Capture one fixed-field image series, then derive atmospheric seeing and tracking drift from the same star sequence."
                           Foreground="#6B7280"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Frames:"
                               Style="{StaticResource MetricLabel}"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="txtSeeingFrames"
                             Style="{StaticResource SmallTextBox}"
                             Text="9"/>
                    <TextBlock Grid.Column="2"
                               Text="frames"
                               Style="{StaticResource MetricLabel}"
                               Margin="8,0,0,0"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Interval:"
                               Style="{StaticResource MetricLabel}"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="txtSeeingInterval"
                             Style="{StaticResource SmallTextBox}"
                             Text="250"/>
                    <TextBlock Grid.Column="2"
                               Text="ms"
                               Style="{StaticResource MetricLabel}"
                               Margin="8,0,0,0"/>
                </Grid>

                <Button x:Name="btnMeasureSeeing"
                        Content="Run Seeing + Tracking Series"
                        Style="{StaticResource ActionButton}"
                        Background="#14B8A6"
                        Click="BtnMeasureSeeing_Click"
                        Margin="0,0,0,10"/>

                <Border Background="#1A1A1A"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Estimated Duration"
                                       Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="txtAnalysisEstimatedDuration"
                                       Text="--"
                                       Foreground="White"
                                       FontSize="14"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Usable Frames"
                                       Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="txtAnalysisUsableFrames"
                                       Text="0"
                                       Foreground="#14B8A6"
                                       FontSize="14"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reference Locked"
                                       Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="txtAnalysisReferenceLocked"
                                       Text="No"
                                       Foreground="#F59E0B"
                                       FontSize="14"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Seeing Result"
                           Foreground="#EC4899"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6"/>
                <Border Background="#1A1A1A"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Seeing (FWHM)"
                                   Style="{StaticResource MetricLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   x:Name="txtSeeingFWHM"
                                   Text="--"
                                   Style="{StaticResource MetricValue}"/>

                        <TextBlock Grid.Row="1" Text="Quality"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   x:Name="txtSeeingQuality"
                                   Text="--"
                                   Style="{StaticResource MetricValue}"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Text="Frames Used"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   x:Name="txtSeeingStarCount"
                                   Text="--"
                                   Foreground="White"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="3" Text="Jump RMS"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   x:Name="txtSeeingStdDev"
                                   Text="--"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <TextBlock Text="Tracking Result"
                           Foreground="#F59E0B"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,6"/>
                <Border Background="#1A1A1A"
                        CornerRadius="4"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="RA Drift Rate"
                                   Style="{StaticResource MetricLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   x:Name="txtTrackingRADrift"
                                   Text="--"
                                   Style="{StaticResource MetricValue}"/>

                        <TextBlock Grid.Row="1" Text="Dec Drift Rate"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   x:Name="txtTrackingDecDrift"
                                   Text="--"
                                   Style="{StaticResource MetricValue}"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Text="RMS Error"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   x:Name="txtTrackingRMS"
                                   Text="--"
                                   Style="{StaticResource MetricValue}"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="3" Text="Peak Error"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   x:Name="txtTrackingPeakError"
                                   Text="--"
                                   Style="{StaticResource MetricValue}"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="4" Text="Periodic Error"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   x:Name="txtTrackingPE"
                                   Text="--"
                                   Foreground="#F59E0B"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="5" Text="Elapsed"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   x:Name="txtTrackingElapsed"
                                   Text="0 / 0 s"
                                   Foreground="White"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <Grid Margin="0,8,0,0">
                    <ProgressBar x:Name="progressTracking"
                                 Height="4"
                                 Minimum="0" Maximum="100" Value="0"
                                 Background="#374151"
                                 Foreground="#14B8A6"/>
                </Grid>

                <TextBlock x:Name="txtSeeingStatus"
                           Text=""
                           Foreground="#6EE7B7"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

                <TextBlock x:Name="txtTrackingStatus"
                           Text=""
                           Foreground="#6EE7B7"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                <Button x:Name="btnOpenSeeingGraph"
                        Content="Open Seeing Graph"
                        Style="{StaticResource ActionButton}"
                        Background="#7C3AED"
                        Click="BtnOpenSeeingGraph_Click"
                        Margin="0,8,0,0"/>

                <Button x:Name="btnOpenTrackingGraph"
                        Content="Open Tracking Graph"
                        Style="{StaticResource ActionButton}"
                        Background="#F59E0B"
                        Click="BtnOpenTrackingGraph_Click"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- POINTING STABILITY SECTION -->
        <Border Background="#2D2D30"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="POINTING STABILITY"
                           Foreground="#3B82F6"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Slew to random sky positions, take multiple images at each position, measure star position jumps."
                           Foreground="#6B7280"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!-- Test Parameters -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Positions:"
                               Style="{StaticResource MetricLabel}"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="txtPointingPositions"
                             Style="{StaticResource SmallTextBox}"
                             Text="5"/>
                    <TextBlock Grid.Column="2"
                               Text="spots"
                               Style="{StaticResource MetricLabel}"
                               Margin="8,0,0,0"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Images/Pos:"
                               Style="{StaticResource MetricLabel}"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="txtPointingImagesPerPos"
                             Style="{StaticResource SmallTextBox}"
                             Text="5"/>
                    <TextBlock Grid.Column="2"
                               Text="images"
                               Style="{StaticResource MetricLabel}"
                               Margin="8,0,0,0"/>
                </Grid>

                <Button x:Name="btnStartPointingTest"
                        Content="Start Pointing Test"
                        Style="{StaticResource ActionButton}"
                        Background="#8B5CF6"
                        Click="BtnStartPointingTest_Click"
                        Margin="0,0,0,10"/>

                <!-- Pointing Results -->
                <Border Background="#1A1A1A"
                        CornerRadius="4"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Avg Jump/Position"
                                   Style="{StaticResource MetricLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   x:Name="txtPointingAvgJump"
                                   Text="--"
                                   Style="{StaticResource MetricValue}"/>

                        <TextBlock Grid.Row="1" Text="Max Jump"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   x:Name="txtPointingMaxJump"
                                   Text="--"
                                   Foreground="#F59E0B"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Text="Total RMS"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   x:Name="txtPointingTotalRMS"
                                   Text="--"
                                   Style="{StaticResource MetricValue}"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="3" Text="Measurements"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   x:Name="txtPointingMeasurements"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="4" Text="Progress"
                                   Style="{StaticResource MetricLabel}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   x:Name="txtPointingProgress"
                                   Text="0 / 0"
                                   Foreground="White"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- Pointing Status -->
                <TextBlock x:Name="txtPointingStatus"
                           Text=""
                           Foreground="#6EE7B7"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

                <Button x:Name="btnOpenPointingGraph"
                        Content="Open Pointing Graph"
                        Style="{StaticResource ActionButton}"
                        Background="#2563EB"
                        Click="BtnOpenPointingGraph_Click"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
