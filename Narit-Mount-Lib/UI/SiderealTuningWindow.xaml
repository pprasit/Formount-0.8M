<Window x:Class="ForkMount_WPF.UI.SiderealTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidereal Tracking - Advanced Tuning"
        Height="720" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="#0F1419"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <SolidColorBrush x:Key="DarkBackground" Color="#0F1419"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1A1F2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D3748"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningYellow" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4B5563"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6B7280"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Border BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Background="#0F1419">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" 
                    Background="#1F2937" 
                    CornerRadius="8,8,0,0"
                    BorderBrush="#2D3748"
                    BorderThickness="0,0,0,1">
                <Grid Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                               Text="Sidereal Tracking - Advanced Tuning"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    
                    <Button Grid.Column="1"
                            Content="✕"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0"
                            FontSize="16"
                            Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EF4444"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="PIDF Controller Tuning"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Separate PID gains and VFF for Azimuth and Altitude axes - tune independently for optimal Earth rotation tracking"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Azimuth Axis -->
                    <Border Grid.Row="1"
                            Background="#1F2937"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="⟲"
                                           Foreground="#3B82F6"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Azimuth Axis"
                                           Foreground="#3B82F6"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Azimuth Kp -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Proportional (Kp)"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAzKp"
                                             Text="1.5"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Position error gain (deg/s per deg)"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Azimuth Ki -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Integral (Ki)"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAzKi"
                                             Text="0.00"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Eliminates steady-state error"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Azimuth Kd -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Derivative (Kd)"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAzKd"
                                             Text="0.3"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Damping gain (reduces oscillation)"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Azimuth VFF -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="VFF Gain"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAzVff"
                                             Text="0.2"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Feedforward scale (0.0 - 1.0)"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Altitude Axis -->
                    <Border Grid.Row="2"
                            Background="#1F2937"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="↕"
                                           Foreground="#10B981"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Altitude Axis"
                                           Foreground="#10B981"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Altitude Kp -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Proportional (Kp)"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAltKp"
                                             Text="1.5"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Position error gain (deg/s per deg)"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Altitude Ki -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Integral (Ki)"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAltKi"
                                             Text="0.00"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Eliminates steady-state error"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Altitude Kd -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Derivative (Kd)"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAltKd"
                                             Text="0.3"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Damping gain (reduces oscillation)"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Altitude VFF -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="VFF Gain"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtAltVff"
                                             Text="0.2"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Feedforward scale (0.0 - 1.0)"
                                               Foreground="#6B7280"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Info & Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Kalman Filter Section -->
                        <Border Grid.Row="0"
                                Background="#1F2937"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="⚡"
                                               Foreground="#F59E0B"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Kalman Filter"
                                               Foreground="#F59E0B"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <CheckBox x:Name="chkKalmanEnabled"
                                              Content="Enable"
                                              IsChecked="True"
                                              Foreground="{StaticResource TextPrimary}"
                                              FontSize="13"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Process Noise Position -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Process Noise (Position)"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,6"/>
                                        <TextBox x:Name="txtKalmanQPos"
                                                 Text="0.0000002"
                                                 Style="{StaticResource ModernTextBox}"/>
                                        <TextBlock Text="Lower = smoother, slower response"
                                                   Foreground="#6B7280"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <!-- Process Noise Velocity -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Process Noise (Velocity)"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,6"/>
                                        <TextBox x:Name="txtKalmanQVel"
                                                 Text="0.000002"
                                                 Style="{StaticResource ModernTextBox}"/>
                                        <TextBlock Text="How fast velocity changes are expected"
                                                   Foreground="#6B7280"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <!-- Measurement Noise -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Measurement Noise (R)"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,6"/>
                                        <TextBox x:Name="txtKalmanR"
                                                 Text="1.0"
                                                 Style="{StaticResource ModernTextBox}"/>
                                        <TextBlock Text="Higher = trust encoder less (more filtering)"
                                                   Foreground="#6B7280"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <!-- Prediction Time -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Prediction Lead (ms)"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   Margin="0,0,0,6"/>
                                        <TextBox x:Name="txtPredictionMs"
                                                 Text="0"
                                                 Style="{StaticResource ModernTextBox}"/>
                                        <TextBlock Text="Aim at future position (0 = off)"
                                                   Foreground="#6B7280"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="btnReset"
                                    Content="Reset to Default"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnReset_Click"
                                    Width="150"
                                    Margin="0,0,12,0"/>
                            <Button x:Name="btnSave"
                                    Content="Save"
                                    Style="{StaticResource SuccessButton}"
                                    Click="BtnSave_Click"
                                    Width="150"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
