<UserControl x:Class="NARIT_Collimation_Manager.UI.CollimationManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#0B1220">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#111827" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#243043" />
        <SolidColorBrush x:Key="PrimaryText" Color="#E5EEF9" />
        <SolidColorBrush x:Key="SecondaryText" Color="#9FB0C7" />
        <SolidColorBrush x:Key="Accent" Color="#F97316" />
        <SolidColorBrush x:Key="AccentSoft" Color="#FED7AA" />
        <SolidColorBrush x:Key="Success" Color="#22C55E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="GridComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#172033" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="#2D3B54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Height" Value="34" />
        </Style>

        <Style x:Key="GridTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#172033" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="#2D3B54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EA580C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowBackground" Value="#0F172A" />
            <Setter Property="AlternatingRowBackground" Value="#111C31" />
            <Setter Property="HorizontalGridLinesBrush" Value="#243043" />
            <Setter Property="VerticalGridLinesBrush" Value="#243043" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="56" />
            <Setter Property="ColumnHeaderHeight" Value="48" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#172033" />
            <Setter Property="Foreground" Value="{StaticResource AccentSoft}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#243043" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Collimation Manager"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Preview-ready UI control for collimation runs and scoring."
                               Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="14" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,10"
                        Background="#172033"
                        CornerRadius="14"
                        BorderBrush="#243043"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Average Score"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="12" />
                        <TextBlock x:Name="AverageScoreText"
                                   Text="-"
                                   Margin="0,4,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Success}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Run Table" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Pick a screw position, enter turn amount, then run that row."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>

                <DataGrid Grid.Row="1"
                          x:Name="CollimationDataGrid"
                          ItemsSource="{Binding Rows}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Index"
                                            Binding="{Binding Sequence}"
                                            Width="90"
                                            IsReadOnly="True" />

                        <DataGridTemplateColumn Header="Screw Position" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource GridComboBoxStyle}"
                                              ItemsSource="{Binding DataContext.ScrewOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding SelectedScrew, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Run" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Run Row"
                                            Style="{StaticResource RunButtonStyle}"
                                            Click="RunRowButton_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Turn" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding TurnText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource GridTextBoxStyle}"
                                             HorizontalContentAlignment="Right"
                                             PreviewTextInput="TurnTextBox_PreviewTextInput"
                                             LostFocus="TurnTextBox_LostFocus" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Collimation Score"
                                            Binding="{Binding ScoreDisplay}"
                                            Width="*"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
