<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NARIT.Mount.API</RootNamespace>
    <AssemblyName>NARIT-Mount-API</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591;NU1701</NoWarn>
    <Description>NARIT Mount Control API - Public API for controlling NARIT Fork Mount telescope systems via Elmo Platinum Drive.</Description>
    <Authors>NARIT</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Project Reference to Narit-Mount-Lib Engine -->
  <ItemGroup>
    <ProjectReference Include="..\Narit-Mount-Lib\Narit-Mount-Lib.csproj" />
  </ItemGroup>

  <!-- PWLib for astronomical calculations (same DLL as Narit-Mount-Lib) -->
  <ItemGroup>
    <Reference Include="PWLib">
      <HintPath>..\Narit-Mount-Lib\dll\PWLib.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
